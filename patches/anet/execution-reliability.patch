+package autoreply
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/ANetResearch/ANet/internal/pathsafe"
+	"github.com/ANetResearch/ANet/module"
+)
+
+// The host reads verified bytes from the interaction's content store. Retry only
+// this read, before starting a backend; never repeat an agent run to fetch a file.
+func (m *autoReplyModule) loadInputAttachment(ix string, a module.TurnAttachment) ([]byte, error) {
+	if a.Size < 0 || a.Size > pathsafe.MaxAttachmentBytes {
+		return nil, fmt.Errorf("attachment_size_limit: %s", a.CID)
+	}
+	var err error
+	for attempt := 0; attempt < 3; attempt++ {
+		var data []byte
+		data, err = m.turns.TurnAttachment(ix, a.CID)
+		if err == nil {
+			if int64(len(data)) != a.Size {
+				return nil, fmt.Errorf("attachment_size_mismatch: %s: expected %d, received %d", a.CID, a.Size, len(data))
+			}
+			return data, nil
+		}
+		if attempt < 2 {
+			timer := time.NewTimer(time.Duration(attempt+1) * 100 * time.Millisecond)
+			select {
+			case <-m.ctx.Done():
+				timer.Stop()
+				return nil, m.ctx.Err()
+			case <-timer.C:
+			}
+		}
+	}
+	return nil, fmt.Errorf("attachment_unavailable: %s: %w", a.CID, err)
+}
+
+// Prefixes make same-name files distinct even on case-insensitive filesystems.
+// Strip both OS separators before applying the cross-platform filename policy.
+func inputFileName(turn, index int, name string) string {
+	name = filepath.Base(strings.ReplaceAll(name, "\\", "/"))
+	name = strings.Map(func(r rune) rune {
+		if strings.ContainsRune(`<>:"|?*`, r) {
+			return '_'
+		}
+		return r
+	}, name)
+	return pathsafe.SafeName(fmt.Sprintf("turn%d-file%d-%s", turn, index, name))
+}
+
+func checkInputLimits(turns []chatTurn) error {
+	count, total := 0, 0
+	for _, t := range turns {
+		for _, f := range t.Files {
+			count++
+			total += len(f.Data)
+		}
+		for _, f := range t.Images {
+			count++
+			total += len(f.Data)
+		}
+	}
+	if count > runnerMaxFiles || total > runnerMaxFileBytes {
+		return fmt.Errorf("attachment_limit: %d files, %d bytes (maximum %d files, %d bytes)", count, total, runnerMaxFiles, runnerMaxFileBytes)
+	}
+	return nil
+}
+
+func writeInputFile(dir, name string, data []byte) error {
+	f, err := os.OpenFile(filepath.Join(dir, name), os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return fmt.Errorf("attachment_write_failed: %w", err)
+	}
+	_, err = f.Write(data)
+	if err == nil {
+		err = f.Sync()
+	}
+	ce := f.Close()
+	if err == nil {
+		err = ce
+	}
+	if err != nil {
+		return fmt.Errorf("attachment_write_failed: %w", err)
+	}
+	// The private input directory is published only after every file is ready.
+	return nil
+}
