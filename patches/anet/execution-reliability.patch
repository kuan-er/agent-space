diff --git a/deploy/operator-release/build.py b/deploy/operator-release/build.py
new file mode 100644
index 0000000..d67e055
--- /dev/null
+++ b/deploy/operator-release/build.py
@@ -0,0 +1,66 @@
+"""Build/sign an explicitly bootstrapped operator channel; never uploads the key."""
+from pathlib import Path
+import argparse, base64, concurrent.futures, datetime, gzip, hashlib, json, os, re, struct, subprocess
+
+p=argparse.ArgumentParser()
+p.add_argument('--key',type=Path,required=True)
+p.add_argument('--out',type=Path,required=True)
+p.add_argument('--version',required=True)
+p.add_argument('--channel',required=True)
+p.add_argument('--go',default='go')
+p.add_argument('--targets',default='linux-amd64,windows-amd64,darwin-arm64')
+a=p.parse_args()
+assert re.fullmatch(r'[0-9]+\.[0-9]+\.[0-9]+-operator\.[0-9]+',a.version)
+assert re.fullmatch(r'[a-z0-9-]{1,64}',a.channel)
+repo=Path(__file__).resolve().parents[2]
+assert not subprocess.check_output(['git','status','--porcelain'],cwd=repo,text=True).strip(), 'commit source first'
+assert not a.out.exists(), 'release directories are immutable'
+a.key=a.key.expanduser().resolve()
+a.key.parent.mkdir(parents=True,exist_ok=True,mode=0o700)
+if not a.key.exists():
+ subprocess.run(['ssh-keygen','-q','-t','ed25519','-N','','-C','ANet operator release '+a.channel,'-f',str(a.key)],check=True)
+assert not (a.key.stat().st_mode & 0o077), 'private signing key must be mode 0600'
+pub=subprocess.check_output(['ssh-keygen','-y','-f',str(a.key)],text=True).split()
+wire=base64.b64decode(pub[1]);n=struct.unpack('>I',wire[:4])[0]
+assert wire[4:4+n]==b'ssh-ed25519'
+keylen=struct.unpack('>I',wire[4+n:8+n])[0];rawkey=wire[8+n:]
+assert keylen==32 and len(rawkey)==32
+fp='SHA256:'+base64.b64encode(hashlib.sha256(wire).digest()).decode().rstrip('=')
+public=base64.b64encode(rawkey).decode()
+commit=subprocess.check_output(['git','rev-parse','HEAD'],cwd=repo,text=True).strip()
+now=datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0)
+stamp=now.strftime('%Y-%m-%dT%H:%M:%SZ')
+a.out.mkdir(parents=True);(a.out/'dl').mkdir()
+flags=' '.join(['-X github.com/ANetResearch/ANet/internal/version.V='+a.version,
+ '-X github.com/ANetResearch/ANet/internal/version.Variant=default',
+ '-X github.com/ANetResearch/ANet/internal/version.Commit='+commit,
+ '-X github.com/ANetResearch/ANet/internal/version.BuiltAt='+stamp,
+ '-X github.com/ANetResearch/ANet/internal/release.OperatorReleaseKey='+public,
+ '-X github.com/ANetResearch/ANet/internal/release.OperatorChannel='+a.channel])
+def build(target):
+ goos,arch=target.split('-');assert goos in ['linux','windows','darwin'] and arch in ['amd64','arm64']
+ name='anet-'+target
+ path=a.out/(name+('.exe' if goos=='windows' else ''))
+ env=os.environ.copy();env.update(GOOS=goos,GOARCH=arch,CGO_ENABLED='0')
+ subprocess.run([a.go,'build','-p','2','-trimpath','-ldflags',flags,'-o',str(path),'./cmd/anet'],cwd=repo,env=env,check=True)
+ data=path.read_bytes();gz=gzip.compress(data,compresslevel=9,mtime=0)
+ (a.out/'dl'/(name+'.gz')).write_bytes(gz)
+ print('built '+target,flush=True)
+ return name,{'variant':'default','os':goos,'arch':arch,'gz_sha256':hashlib.sha256(gz).hexdigest(),'gz_size':len(gz),'sha256':hashlib.sha256(data).hexdigest(),'size':len(data)}
+with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:assets=dict(pool.map(build,a.targets.split(',')))
+# Probe the native build for the actual module set; custom builds never inherit
+# a guessed module list or the shell variant's execution privileges.
+import platform
+native='anet-'+('darwin' if platform.system()=='Darwin' else 'linux')+'-'+('arm64' if platform.machine() in ['arm64','aarch64'] else 'amd64')
+probe=subprocess.check_output([str(a.out/native),'version'],text=True)
+mods=next(line.split(': ',1)[1].split(',') for line in probe.splitlines() if line.startswith('modules: '))
+m={'schema':'anet-release/1','version':a.version,'commit':commit,'built_at':stamp,'released_at':stamp,
+ 'expires_at':(now+datetime.timedelta(days=90)).strftime('%Y-%m-%dT%H:%M:%SZ'),
+ 'go':subprocess.check_output([a.go,'env','GOVERSION'],text=True).strip(),'key_fingerprint':fp,'next_key_fingerprint':'',
+ 'maintenance':{'protocol':1,'data_epoch':1},'variants':{'default':{'asset_prefix':'anet','tags':'','modules':mods}},'assets':assets}
+mf=a.out/'dl/release.json';mf.write_text(json.dumps(m,indent=2)+'\n')
+subprocess.run(['ssh-keygen','-Y','sign','-f',str(a.key),'-n','anet-release@agentnetwork.org.cn',str(mf)],check=True)
+result=subprocess.run([str(a.out/native),'update','--verify-dir',str(a.out/'dl')],text=True,capture_output=True,check=True)
+(a.out/'verification.json').write_text(json.dumps({'native_probe':probe,'signature_verification':json.loads(result.stdout),'channel':a.channel,'signing_public_key':public,'fingerprint':fp,'commit':commit},indent=2)+'\n')
+(a.out/'operator-release.pub').write_text(' '.join(pub)+'\n')
+print(json.dumps({'version':a.version,'channel':a.channel,'fingerprint':fp,'commit':commit,'out':str(a.out)},indent=2))
