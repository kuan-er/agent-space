+			files := []chatFile{{Name: "插件.zip", Mime: "application/zip", Data: []byte("zip bytes")}, {Name: "report.pdf", Mime: "application/pdf", Data: []byte("pdf bytes")}, {Name: "data.csv", Mime: "text/csv", Data: []byte("a,b\n1,2")}, {Name: "插件.zip", Mime: "application/zip", Data: []byte("different")}}
+			turns := []chatTurn{{Role: "user", Text: "work on the project", Files: files, Images: []chatImage{{Mime: "image/png", Data: []byte("image")}}}}
+			reply, err := r.Reply(context.Background(), replyContext{InteractionID: "task-one"}, turns)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, f := range files {
