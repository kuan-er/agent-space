diff --git a/cmd/anet/maintenance.go b/cmd/anet/maintenance.go
new file mode 100644
index 0000000..70576f7
--- /dev/null
+++ b/cmd/anet/maintenance.go
@@ -0,0 +1,436 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"log"
+	"os"
+	"os/exec"
+	"os/signal"
+	"path/filepath"
+	"runtime"
+	"sync"
+	"syscall"
+	"time"
+
+	"github.com/ANetResearch/ANet/internal/daemon"
+	"github.com/ANetResearch/ANet/internal/maintenance"
+	"github.com/ANetResearch/ANet/internal/release"
+	"github.com/ANetResearch/ANet/internal/version"
+	"github.com/ANetResearch/ANet/module"
+)
+
+func maintenanceStore(l daemon.Layout) maintenance.Store {
+	return maintenance.Store{Dir: filepath.Join(l.Root, "maintenance")}
+}
+
+func runMaintenance(l daemon.Layout, args []string) error {
+	pos, flags := splitFlags(args)
+	if len(pos) != 1 {
+		return errors.New("usage: anet maintenance enable|disable|status|check [--interval 6h] [--base https://host]")
+	}
+	if len(flags) != 0 && pos[0] != "enable" && pos[0] != "run" {
+		return errors.New("flags only apply to enable or run")
+	}
+	for flag := range flags {
+		valid := pos[0] == "enable" && (flag == "interval" || flag == "base") || pos[0] == "run" && flag == "root"
+		if !valid {
+			return fmt.Errorf("--%s does not apply to maintenance %s", flag, pos[0])
+		}
+	}
+	if pos[0] == "run" {
+		if root, ok := flags["root"]; ok {
+			if !filepath.IsAbs(root) {
+				return errors.New("--root must be absolute")
+			}
+			l.Root = root
+		}
+		return runSupervisor(l)
+	}
+	if pos[0] == "install-service" || pos[0] == "remove-service" {
+		return maintenanceService(l, pos[0] == "remove-service")
+	}
+	s := maintenanceStore(l)
+	cfg, err := s.Config(version.Variant != "")
+	if err != nil {
+		return err
+	}
+	switch pos[0] {
+	case "enable", "disable":
+		cfg.Enabled = pos[0] == "enable"
+		if v, ok := flags["interval"]; ok {
+			cfg.Interval = v
+		}
+		if v, ok := flags["base"]; ok {
+			cfg.Base = v
+			if _, err := release.BaseSource(v); err != nil {
+				return err
+			}
+		}
+		if _, err := cfg.Duration(); err != nil {
+			return err
+		}
+		if err := s.Write("config.json", cfg); err != nil {
+			return err
+		}
+		fmt.Printf("automatic updates: %t; interval: %s\n", cfg.Enabled, cfg.Interval)
+		fmt.Println("A supervised node reloads this setting automatically. For an existing ordinary daemon, enable it on the next `anet stop` / `anet up`.")
+		if version.Variant == "" {
+			fmt.Println("This source build has no signed release variant; downloads are disabled until a signed release is installed.")
+		}
+		return nil
+	case "status":
+		var st maintenance.State
+		err := s.Read("state.json", &st)
+		if err != nil && !errors.Is(err, os.ErrNotExist) {
+			return err
+		}
+		out := map[string]any{"config": cfg, "state": st, "supervisor_running": daemon.DataLockHeld(daemon.Layout{Root: s.Dir}), "signed_variant": version.Variant}
+		return json.NewEncoder(os.Stdout).Encode(out)
+	case "check":
+		if !cfg.Enabled {
+			return errors.New("automatic updates are disabled; run `anet maintenance enable` first")
+		}
+		if err := s.Write("check.request", map[string]string{"requested_at": time.Now().UTC().Format(time.RFC3339Nano)}); err != nil {
+			return err
+		}
+		fmt.Println("Update check queued; the supervisor will check without interrupting tasks. `anet maintenance status` shows progress.")
+		return nil
+	default:
+		return errors.New("unknown maintenance command")
+	}
+}
+
+// pipeChild uses inherited stdin/stdout as a private, cross-platform control
+// channel. PID/health cannot be spoofed by a process holding a loopback port.
+type pipeChild struct {
+	cmd  *exec.Cmd
+	in   io.WriteCloser
+	out  io.ReadCloser
+	enc  *json.Encoder
+	dec  *json.Decoder
+	done chan struct{}
+	err  error
+	mu   sync.Mutex
+}
+
+func startMaintenanceChild(l daemon.Layout, r maintenance.Runtime) (maintenance.Child, error) {
+	c := &pipeChild{cmd: exec.Command(r.Path, "daemon", "--supervised"), done: make(chan struct{})}
+	c.cmd.Env = append(os.Environ(), "ANET_DATA_DIR="+l.Root)
+	c.cmd.Stderr = os.Stderr
+	var err error
+	if c.in, err = c.cmd.StdinPipe(); err != nil {
+		return nil, err
+	}
+	if c.out, err = c.cmd.StdoutPipe(); err != nil {
+		c.in.Close()
+		return nil, err
+	}
+	c.enc, c.dec = json.NewEncoder(c.in), json.NewDecoder(c.out)
+	if err = c.cmd.Start(); err != nil {
+		c.Close()
+		return nil, err
+	}
+	go func() { c.err = c.cmd.Wait(); close(c.done) }()
+	return c, nil
+}
+
+func (c *pipeChild) Call(ctx context.Context, action string) (maintenance.Health, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	type result struct {
+		h   maintenance.Health
+		err error
+	}
+	res := make(chan result, 1)
+	go func() {
+		var h maintenance.Health
+		err := c.enc.Encode(map[string]string{"action": action})
+		if err == nil {
+			err = c.dec.Decode(&h)
+		}
+		if err == nil && h.PID != c.cmd.Process.Pid {
+			err = errors.New("supervised PID mismatch")
+		}
+		res <- result{h, err}
+	}()
+	select {
+	case r := <-res:
+		return r.h, r.err
+	case <-ctx.Done():
+		// Invalidate the stream after a timeout; a late response must never
+		// be mistaken for the acknowledgement of the next command.
+		c.Close()
+		<-res
+		return maintenance.Health{}, ctx.Err()
+	}
+}
+func (c *pipeChild) Done() <-chan struct{} { return c.done }
+func (c *pipeChild) Err() error            { return c.err }
+func (c *pipeChild) Close() {
+	if c.in != nil {
+		_ = c.in.Close()
+	}
+	if c.out != nil {
+		_ = c.out.Close()
+	}
+}
+
+// runSupervisedDaemon emits only protocol JSON on stdout. Daemon diagnostics go
+// to stderr/log, never into the supervisor's message stream.
+func runSupervisedDaemon(l daemon.Layout) error {
+	d, err := daemon.NewStandby(l)
+	if err != nil {
+		return err
+	}
+	defer d.Close()
+	ctx, cancel := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer cancel()
+	served := make(chan error, 1)
+	go func() { served <- d.ServeControl(ctx) }()
+	type request struct {
+		Action string `json:"action"`
+	}
+	requests := make(chan request)
+	go func() {
+		defer close(requests)
+		dec := json.NewDecoder(os.Stdin)
+		for {
+			var r request
+			if dec.Decode(&r) != nil {
+				return
+			}
+			select {
+			case requests <- r:
+			case <-ctx.Done():
+				return
+			}
+		}
+	}()
+	enc := json.NewEncoder(os.Stdout)
+	for {
+		select {
+		case err := <-served:
+			return err
+		case <-ctx.Done():
+			d.RequestStop()
+			return <-served
+		case req, ok := <-requests:
+			if !ok {
+				// Losing the supervisor must not interrupt a running task.
+				// Standby/idle nodes may stop; active nodes keep serving and
+				// can still be stopped through the ordinary control plane.
+				if d.MaintenanceStatus().Held {
+					d.RequestStop()
+					return <-served
+				}
+				log.Print("maintenance: supervisor disconnected; node continues without automatic updates")
+				requests = nil
+				continue
+			}
+			var problem error
+			switch req.Action {
+			case "health":
+			case "prepare":
+				problem = d.PrepareMaintenance()
+			case "activate", "resume":
+				d.ResumeMaintenance()
+			case "shutdown":
+				d.RequestStop()
+			default:
+				problem = errors.New("unknown maintenance action")
+			}
+			h := d.MaintenanceStatus()
+			if problem != nil {
+				h.Reason = problem.Error()
+			}
+			if err := enc.Encode(h); err != nil {
+				d.RequestStop()
+				return <-served
+			}
+		}
+	}
+}
+
+func runSupervisor(l daemon.Layout) error {
+	hideOwnConsoleIfAlone()
+	if err := refuseConfig(l); err != nil {
+		return err
+	}
+	if _, _, err := daemon.EnsureLayoutInit(l); err != nil {
+		return err
+	}
+	s := maintenanceStore(l)
+	if err := s.Init(); err != nil {
+		return err
+	}
+	lock, err := daemon.AcquireDataLock(daemon.Layout{Root: s.Dir})
+	if err != nil {
+		return err
+	}
+	defer lock.Release()
+	// Never adopt an unrelated foreground daemon or try to kill it by PID.
+	if daemon.DataLockHeld(l) {
+		return errors.New("node is already running without this supervisor")
+	}
+	exe, err := os.Executable()
+	if err != nil {
+		return err
+	}
+	exe, err = resolveExe(exe)
+	if err != nil {
+		return err
+	}
+	initial := maintenance.Runtime{Path: exe, Version: version.V, Commit: version.Commit}
+	ctx, cancel := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
+	defer cancel()
+	super := maintenance.Supervisor{Store: s, Initial: initial, DefaultEnabled: version.Variant != ""}
+	super.Start = func(r maintenance.Runtime) (maintenance.Child, error) {
+		if err := maintenance.ValidateRuntime(s.Dir, r, initial); err != nil {
+			return nil, err
+		}
+		if r.SHA256 != "" {
+			check := release.CheckInstalled(r.Path, release.DefaultTrust(), time.Now())
+			if check.Status != release.InstalledVerified || check.Version != r.Version {
+				return nil, errors.New("runtime signature/hash check failed")
+			}
+		}
+		return startMaintenanceChild(l, r)
+	}
+	super.Check = func(ctx context.Context, cfg maintenance.Config, current maintenance.Runtime) (*maintenance.Runtime, error) {
+		if version.Variant == "" {
+			return nil, maintenance.Refusal("source_build_has_no_signed_update_channel")
+		}
+		installed := release.CheckInstalled(current.Path, release.DefaultTrust(), time.Now())
+		if installed.Status != release.InstalledVerified {
+			return nil, maintenance.Refusal("installed_runtime_has_no_verified_release_record")
+		}
+		var sources []release.Source
+		if release.OperatorChannel != "" && cfg.Base == "" {
+			return nil, maintenance.Refusal("operator_channel_requires_explicit_base")
+		}
+		if cfg.Base != "" {
+			source, e := release.BaseSource(cfg.Base)
+			if e != nil {
+				return nil, e
+			}
+			sources = []release.Source{source}
+		} else {
+			probed, rest := release.Sources(version.Variant, runtime.GOOS, runtime.GOARCH)
+			sources = release.OrderSources(ctx, nil, probed, rest, 0)
+		}
+		u := release.Updater{Sources: sources, Trust: release.DefaultTrust(), Current: current.Version, Variant: version.Variant, GOOS: runtime.GOOS, GOARCH: runtime.GOARCH}
+		found, e := u.Check(ctx)
+		if e != nil {
+			log.Print("maintenance: release verification failed")
+			return nil, e
+		}
+		if found.Cmp <= 0 {
+			return nil, nil
+		}
+		if !found.Manifest.CanAutoUpdate() {
+			return nil, maintenance.Refusal("release_requires_explicit_migration_or_supervisor_upgrade")
+		}
+		if additiveMismatch(module.Compiled(), found.Modules) {
+			return nil, maintenance.Refusal("release_changes_execution_privileges")
+		}
+		var state maintenance.State
+		if e = s.Read("state.json", &state); e != nil {
+			return nil, e
+		}
+		if state.Quarantine[found.Asset.SHA256] != "" {
+			return nil, maintenance.Refusal("release_quarantined_after_health_failure")
+		}
+		dir := filepath.Join(s.Dir, "versions", found.Asset.SHA256)
+		if e = os.MkdirAll(dir, 0700); e != nil {
+			return nil, e
+		}
+		path := filepath.Join(dir, filepath.Base(initial.Path))
+		target := &maintenance.Runtime{Path: path, Version: found.Manifest.Version, Commit: found.Manifest.Commit, SHA256: found.Asset.SHA256}
+		cached := release.CheckInstalled(path, release.DefaultTrust(), time.Now())
+		if cached.Status == release.InstalledVerified && cached.Version == target.Version {
+			return target, nil
+		}
+		u.Exe = path
+		if e = u.Apply(ctx, found); e != nil {
+			return nil, e
+		}
+		if e = release.SaveInstalled(path, found.Raw, found.Sig); e != nil {
+			return nil, e
+		}
+		return &maintenance.Runtime{Path: path, Version: found.Manifest.Version, Commit: found.Manifest.Commit, SHA256: found.Asset.SHA256}, nil
+	}
+	return super.Run(ctx)
+}
+
+func supervisedLaunch(l daemon.Layout) (bool, error) {
+	s := maintenanceStore(l)
+	cfg, err := s.Config(version.Variant != "")
+	if err != nil {
+		return false, err
+	}
+	var st maintenance.State
+	if err = s.Read("state.json", &st); err == nil {
+		return true, nil
+	}
+	if !errors.Is(err, os.ErrNotExist) {
+		return false, err
+	}
+	return cfg.Enabled, nil
+}
+
+// The stable installation remains the service/MCP entry point. New client
+// sessions follow the pinned runtime so its guide and MCP schema stay together.
+// Installation/path-writing commands and executable version probes stay local.
+func forwardMaintainedClient(l daemon.Layout, args []string) (bool, int, error) {
+	if len(args) > 0 {
+		switch args[0] {
+		case "version", "--version", "-v", "daemon", "up", "supervise", "maintenance", "update", "uninstall", "init", "agents", "runner":
+			return false, 0, nil
+		}
+	}
+	var st maintenance.State
+	s := maintenanceStore(l)
+	if err := s.Read("state.json", &st); err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			return false, 0, nil
+		}
+		return false, 0, err
+	}
+	if st.Current.SHA256 == "" {
+		return false, 0, nil
+	}
+	exe, err := os.Executable()
+	if err != nil {
+		return false, 0, err
+	}
+	exe, err = resolveExe(exe)
+	if err != nil {
+		return false, 0, err
+	}
+	if exe == st.Current.Path {
+		return false, 0, nil
+	}
+	if err = maintenance.ValidateRuntime(s.Dir, st.Current, maintenance.Runtime{Path: exe}); err != nil {
+		return false, 0, err
+	}
+	check := release.CheckInstalled(st.Current.Path, release.DefaultTrust(), time.Now())
+	if check.Status != release.InstalledVerified || check.Version != st.Current.Version {
+		return false, 0, errors.New("pinned client signature/hash check failed")
+	}
+	c := exec.Command(st.Current.Path, os.Args[1:]...)
+	c.Stdin, c.Stdout, c.Stderr = os.Stdin, os.Stdout, os.Stderr
+	if err = c.Run(); err != nil {
+		var exit *exec.ExitError
+		if errors.As(err, &exit) {
+			return true, exit.ExitCode(), nil
+		}
+		return true, 1, err
+	}
+	return true, 0, nil
+}
diff --git a/cmd/anet/maintenance_service.go b/cmd/anet/maintenance_service.go
new file mode 100644
index 0000000..ae464fa
--- /dev/null
+++ b/cmd/anet/maintenance_service.go
@@ -0,0 +1,140 @@
+package main
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/xml"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strconv"
+	"strings"
+
+	"github.com/ANetResearch/ANet/internal/daemon"
+)
+
+// Startup is per-user, without sudo, service-account changes or desktop-session
+// elevation. Windows GUI agents start at that user's next interactive logon.
+func maintenanceService(l daemon.Layout, remove bool) error {
+	exe, err := os.Executable()
+	if err != nil {
+		return err
+	}
+	exe, err = resolveExe(exe)
+	if err != nil {
+		return err
+	}
+	root, err := filepath.Abs(l.Root)
+	if err != nil {
+		return err
+	}
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return err
+	}
+	if strings.ContainsAny(root+exe+os.Getenv("PATH"), "\r\n\x00") {
+		return errors.New("startup paths contain control characters")
+	}
+	sum := sha256.Sum256([]byte(root))
+	name := "org.agentnetwork." + hex.EncodeToString(sum[:8])
+	var path, body string
+	switch runtime.GOOS {
+	case "darwin":
+		path = filepath.Join(home, "Library", "LaunchAgents", name+".plist")
+		if !remove {
+			body = maintenancePlist(name, exe, root, os.Getenv("PATH"))
+		}
+	case "linux":
+		base := os.Getenv("XDG_CONFIG_HOME")
+		if base == "" {
+			base = filepath.Join(home, ".config")
+		}
+		path = filepath.Join(base, "systemd", "user", name+".service")
+		if !remove {
+			body = maintenanceUnit(exe, root, os.Getenv("PATH"))
+		}
+	case "windows":
+		key := `HKCU\Software\Microsoft\Windows\CurrentVersion\Run`
+		args := []string{"ADD", key, "/v", name, "/t", "REG_SZ", "/d", `"` + exe + `" maintenance run --root "` + root + `"`, "/f"}
+		if remove {
+			args = []string{"DELETE", key, "/v", name, "/f"}
+		}
+		if out, e := exec.Command("reg.exe", args...).CombinedOutput(); e != nil {
+			return fmt.Errorf("startup registry: %w: %s", e, out)
+		}
+		fmt.Println("Updated per-user logon startup:", name)
+		return nil
+	default:
+		return errors.New("startup integration supports Linux, macOS and Windows")
+	}
+	if remove {
+		if runtime.GOOS == "darwin" {
+			label := "gui/" + strconv.Itoa(os.Getuid()) + "/" + name
+			if out, e := exec.Command("launchctl", "disable", label).CombinedOutput(); e != nil {
+				return fmt.Errorf("disable startup: %w: %s", e, out)
+			}
+		}
+		if runtime.GOOS == "linux" {
+			if out, e := exec.Command("systemctl", "--user", "disable", name+".service").CombinedOutput(); e != nil {
+				return fmt.Errorf("disable startup: %w: %s", e, out)
+			}
+		}
+		if e := os.Remove(path); e != nil && !errors.Is(e, os.ErrNotExist) {
+			return e
+		}
+	} else {
+		if err = os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+			return err
+		}
+		if err = os.WriteFile(path, []byte(body), 0600); err != nil {
+			return err
+		}
+	}
+	if runtime.GOOS == "linux" {
+		if out, e := exec.Command("systemctl", "--user", "daemon-reload").CombinedOutput(); e != nil {
+			return fmt.Errorf("startup file saved at %s, but user systemd is unavailable: %w: %s", path, e, out)
+		}
+		if !remove {
+			if out, e := exec.Command("systemctl", "--user", "enable", name+".service").CombinedOutput(); e != nil {
+				return fmt.Errorf("enable startup: %w: %s", e, out)
+			}
+		}
+	}
+	if !remove && runtime.GOOS == "darwin" {
+		label := "gui/" + strconv.Itoa(os.Getuid()) + "/" + name
+		if out, e := exec.Command("launchctl", "enable", label).CombinedOutput(); e != nil {
+			return fmt.Errorf("startup file saved at %s but enabling launchd failed: %w: %s", path, e, out)
+		}
+	}
+	fmt.Println("Updated startup file:", path)
+	fmt.Println("Takes effect at next user login. Existing tasks keep running. Linux before-login startup requires the operator's existing user-lingering policy.")
+	return nil
+}
+
+func maintenancePlist(name, exe, root, path string) string {
+	esc := func(s string) string { var b strings.Builder; _ = xml.EscapeText(&b, []byte(s)); return b.String() }
+	return fmt.Sprintf(`<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0"><dict>
+<key>Label</key><string>%s</string>
+<key>ProgramArguments</key><array><string>%s</string><string>maintenance</string><string>run</string><string>--root</string><string>%s</string></array>
+<key>EnvironmentVariables</key><dict><key>PATH</key><string>%s</string></dict>
+<key>RunAtLoad</key><true/>
+<key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
+<key>ThrottleInterval</key><integer>30</integer>
+<key>StandardErrorPath</key><string>%s</string>
+</dict></plist>
+`, esc(name), esc(exe), esc(root), esc(path), esc(filepath.Join(root, "daemon.log")))
+}
+
+func maintenanceUnit(exe, root, path string) string {
+	// systemd expands %% and $ even without a shell. Quote each argv item and
+	// escape both so directory names cannot become specifiers/arguments.
+	q := func(s string) string {
+		return strconv.Quote(strings.ReplaceAll(strings.ReplaceAll(s, "%", "%%"), "$", "$$"))
+	}
+	return "[Unit]\nDescription=ANet supervised node\nAfter=network-online.target\n\n[Service]\nType=simple\nExecStart=" + q(exe) + " maintenance run --root " + q(root) + "\nEnvironment=" + strconv.Quote("PATH="+strings.ReplaceAll(path, "%", "%%")) + "\nRestart=on-failure\nRestartSec=30\nKillMode=process\nTimeoutStopSec=75\n\n[Install]\nWantedBy=default.target\n"
+}
diff --git a/cmd/anet/maintenance_test.go b/cmd/anet/maintenance_test.go
new file mode 100644
index 0000000..bc69a18
--- /dev/null
+++ b/cmd/anet/maintenance_test.go
@@ -0,0 +1,181 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"encoding/xml"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/ANetResearch/ANet/internal/daemon"
+	"github.com/ANetResearch/ANet/internal/maintenance"
+	"github.com/ANetResearch/ANet/internal/version"
+)
+
+// Real subprocess + real node, isolated credentials/data/home. Pipe control is
+// used on every OS, including ones without Linux TCP owner attestation.
+func TestMaintenanceSupervisedDaemonLifecycle(t *testing.T) {
+	h := newCLIHome(t, "C")
+	if out, errOut, code := runCLI(t, h, []string{"init"}); code != 0 {
+		t.Fatalf("init %d %s %s", code, out, errOut)
+	}
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := &pipeChild{cmd: exec.Command(exe, "daemon", "--supervised"), done: make(chan struct{})}
+	c.cmd.Env = h.env()
+	c.cmd.Stderr = os.Stderr
+	if c.in, err = c.cmd.StdinPipe(); err != nil {
+		t.Fatal(err)
+	}
+	if c.out, err = c.cmd.StdoutPipe(); err != nil {
+		t.Fatal(err)
+	}
+	c.enc, c.dec = json.NewEncoder(c.in), json.NewDecoder(c.out)
+	if err = c.cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	go func() { c.err = c.cmd.Wait(); close(c.done) }()
+	t.Cleanup(func() {
+		c.Close()
+		select {
+		case <-c.Done():
+		case <-time.After(10 * time.Second):
+			_ = c.cmd.Process.Kill()
+			<-c.Done()
+		}
+	})
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	defer cancel()
+	var health maintenance.Health
+	for {
+		health, err = c.Call(ctx, "health")
+		if err != nil {
+			t.Fatal(err)
+		}
+		if health.Serving {
+			break
+		}
+		select {
+		case <-ctx.Done():
+			t.Fatal(ctx.Err())
+		case <-time.After(20 * time.Millisecond):
+		}
+	}
+	if !health.Held || health.Version != version.V || health.Commit != version.Commit {
+		t.Fatalf("standby: %+v", health)
+	}
+	if health, err = c.Call(ctx, "activate"); err != nil || health.Held {
+		t.Fatalf("activate: %+v %v", health, err)
+	}
+	if health, err = c.Call(ctx, "prepare"); err != nil || !health.Held {
+		t.Fatalf("idle gate: %+v %v", health, err)
+	}
+	if health, err = c.Call(ctx, "resume"); err != nil || health.Held {
+		t.Fatalf("resume: %+v %v", health, err)
+	}
+	if _, err = c.Call(ctx, "shutdown"); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-c.Done():
+		if c.Err() != nil {
+			t.Fatal(c.Err())
+		}
+	case <-ctx.Done():
+		t.Fatal("child did not stop")
+	}
+	if daemon.DataLockHeld(daemon.Layout{Root: h.data}) {
+		t.Fatal("child retained data lock")
+	}
+}
+
+func TestMaintenanceStartupTemplatesEscapePaths(t *testing.T) {
+	path := `/tmp/a space & <tag>/$HOME/%n/anet`
+	p := maintenancePlist("org.agentnetwork.test", path, path, path)
+	dec := xml.NewDecoder(strings.NewReader(p))
+	for {
+		_, err := dec.Token()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	if !strings.Contains(p, "&amp;") || !strings.Contains(p, "&lt;tag&gt;") {
+		t.Fatal("unescaped XML")
+	}
+	u := maintenanceUnit(path, path, path)
+	if !strings.Contains(u, "$$HOME/%%n") || !strings.Contains(u, "Restart=on-failure") || !strings.Contains(u, "KillMode=process") {
+		t.Fatal(u)
+	}
+}
+
+func TestMaintenanceCLISettingsAreLocalAndBounded(t *testing.T) {
+	h := newCLIHome(t, "C")
+	for _, args := range [][]string{{"maintenance", "enable", "--interval", "1s"}, {"maintenance", "enable", "--base", "http://example.test"}} {
+		_, _, code := runCLI(t, h, args)
+		if code == 0 {
+			t.Fatalf("accepted %v", args)
+		}
+	}
+	_, stderr, code := runCLI(t, h, []string{"maintenance", "enable", "--interval", "2h"})
+	if code != 0 {
+		t.Fatal(stderr)
+	}
+	var cfg maintenance.Config
+	if err := maintenanceStore(daemon.Layout{Root: h.data}).Read("config.json", &cfg); err != nil || !cfg.Enabled || cfg.Interval != "2h" {
+		t.Fatalf("%+v %v", cfg, err)
+	}
+	_, stderr, code = runCLI(t, h, []string{"maintenance", "disable"})
+	if code != 0 {
+		t.Fatal(stderr)
+	}
+}
+
+func TestMaintenanceDisableKeepsPinnedRuntime(t *testing.T) {
+	l := daemon.Layout{Root: t.TempDir()}
+	s := maintenanceStore(l)
+	if err := s.Write("config.json", maintenance.Config{Enabled: false, Interval: "6h"}); err != nil {
+		t.Fatal(err)
+	}
+	if yes, err := supervisedLaunch(l); yes || err != nil {
+		t.Fatalf("new disabled node: %v %v", yes, err)
+	}
+	if err := s.Save(&maintenance.State{Schema: 1, Current: maintenance.Runtime{Path: "pinned"}}, "running", ""); err != nil {
+		t.Fatal(err)
+	}
+	if yes, err := supervisedLaunch(l); !yes || err != nil {
+		t.Fatalf("disabled node lost pinned runtime: %v %v", yes, err)
+	}
+}
+
+func TestMaintenanceClientRefusesUnverifiedPinnedBinary(t *testing.T) {
+	l := daemon.Layout{Root: t.TempDir()}
+	s := maintenanceStore(l)
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	exe, err = resolveExe(exe)
+	if err != nil {
+		t.Fatal(err)
+	}
+	r := maintenance.Runtime{Path: filepath.Join(s.Dir, "versions", strings.Repeat("a", 64), filepath.Base(exe)), Version: "9.0.0", SHA256: strings.Repeat("a", 64)}
+	if err = s.Save(&maintenance.State{Schema: 1, Current: r}, "running", ""); err != nil {
+		t.Fatal(err)
+	}
+	if forwarded, _, err := forwardMaintainedClient(l, []string{"mcp"}); forwarded || err == nil {
+		t.Fatal("unverified MCP runtime was accepted")
+	}
+	if forwarded, _, err := forwardMaintainedClient(l, []string{"maintenance", "status"}); forwarded || err != nil {
+		t.Fatal("cannot diagnose a broken runtime")
+	}
+}
diff --git a/cmd/anet/tree_test.go b/cmd/anet/tree_test.go
