+// A real, portable child process exercises each backend's stdin/file/argv
+// transport without a model, credentials, shell script or network service.
+func reliabilityFixture() int {
+	b, _ := io.ReadAll(os.Stdin)
+	text := string(b) + "\n" + strings.Join(os.Args[1:], "\n")
+	for _, a := range os.Args {
+		if raw, ok := strings.CutPrefix(a, "developer_instructions="); ok {
+			if decoded, err := strconv.Unquote(raw); err == nil {
+				text += "\n" + decoded
+			}
+		}
+	}
+	if match := regexp.MustCompile(`Read the file (.*?): it holds the conversation`).FindStringSubmatch(text); match != nil {
+		b, err := os.ReadFile(match[1])
+		if err != nil {
+			return 9
+		}
+		text += "\n" + string(b)
+	}
+	for i, a := range os.Args {
+		if a == "--message-file" && i+1 < len(os.Args) {
+			b, err := os.ReadFile(os.Args[i+1])
+			if err != nil {
+				return 10
+			}
+			text += "\n" + string(b)
+		}
+	}
+	answer := ""
+	if strings.Contains(text, "Select the workspace project for this task.") {
+		answer = `{"project":"sample","purpose":"test project"}`
+		if strings.Contains(text, "NEW_PROJECT") {
+			answer = `{"project":"another","purpose":"new project"}`
+		}
+		if strings.Contains(text, "BAD_PROJECT") {
+			answer = `{"project":"../escape","purpose":"bad"}`
+		}
+		if strings.Contains(text, "AMBIGUOUS") {
+			answer = `{"question":"Which existing project?"}`
+		}
+	} else {
+		if strings.Contains(text, "WAIT_FOR_CANCEL") {
+			time.Sleep(30 * time.Second)
+		}
+		if strings.Contains(text, "FAIL_AFTER_EFFECT") {
+			_ = os.WriteFile("effect.txt", []byte("done"), 0600)
+			return 17
+		}
+		if match := regexp.MustCompile(`bound to project "([a-z0-9-]+)"`).FindStringSubmatch(text); match != nil {
+			if os.WriteFile(filepath.Join("projects", match[1], "executed.txt"), []byte("executed"), 0600) != nil {
+				return 11
+			}
+		}
+		dirs, _ := filepath.Glob(".anet-in-*")
+		for _, dir := range dirs {
+			entries, _ := os.ReadDir(dir)
+			for _, entry := range entries {
+				if entry.Name() == "conversation.md" {
+					continue
+				}
+				data, err := os.ReadFile(filepath.Join(dir, entry.Name()))
+				if err != nil {
+					return 12
+				}
+				answer += fmt.Sprintf("%s:%x\n", entry.Name(), sha256.Sum256(data))
+			}
+		}
+		if answer == "" {
+			answer = "done"
+		}
+	}
+	for i, a := range os.Args {
+		if a == "-o" && i+1 < len(os.Args) {
+			if os.WriteFile(os.Args[i+1], []byte(answer), 0600) != nil {
+				return 13
+			}
+		}
+	}
+	fmt.Print(answer)
+	return 0
+}
+
+func fixtureReplier(t *testing.T, agent, root string) *execReplier {
