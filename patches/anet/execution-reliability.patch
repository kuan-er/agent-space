+package release
+
+import (
+	"encoding/base64"
+	"testing"
+)
+
+func TestOperatorReleaseTrustDoesNotGrantOfficialIdentity(t *testing.T) {
+	pub, _ := newKey(t)
+	oldKey, oldName := OperatorReleaseKey, OperatorChannel
+	defer func() { OperatorReleaseKey, OperatorChannel = oldKey, oldName }()
+	OperatorReleaseKey = base64.StdEncoding.EncodeToString(pub)
+	OperatorChannel = "test-private"
+	if !DefaultTrust().accepts(pub) {
+		t.Fatal("operator key refused")
+	}
+	if OfficialTrust().accepts(pub) {
+		t.Fatal("operator key acquired official-agent authority")
+	}
+	for _, official := range embeddedTrust(Namespace).Keys {
+		if DefaultTrust().accepts(official) {
+			t.Fatal("private channel fell back to unrelated publisher")
+		}
+	}
+}
