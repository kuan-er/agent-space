+	files, _ := filepath.Glob(filepath.Join(e.dir, "*.json"))
+	if len(files) < 3 {
+		t.Fatal("missing durable timeline")
+	}
+	first, _ := os.ReadFile(files[0])
+	var s map[string]any
+	_ = json.Unmarshal(first, &s)
+	if s["phase"] != "preparing_inputs" {
+		t.Fatal("overwrote start")
+	}
+}
+
+func TestReliabilityNewInstructionStopsOldProcess(t *testing.T) {
+	ctx, e, h := testExecution(t)
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	stop := e.watch(ctx, cancel)
+	defer stop()
+	self, _ := os.Executable()
+	done := make(chan error, 1)
+	go func() {
+		_, _, err := runCmd(ctx, execInvokeOpts{WorkDir: t.TempDir(), Env: []string{"TERM=anet-reliability-fixture"}}, []byte("WAIT_FOR_CANCEL"), self, "exec")
+		done <- err
+	}()
+	deadline := time.Now().Add(3 * time.Second)
+	for e.value("process_state") != "running" && time.Now().Before(deadline) {
+		time.Sleep(10 * time.Millisecond)
+	}
+	h.mu.Lock()
+	h.turn.Messages = []module.TurnMessage{{ID: "v2", From: "them", Body: "read only"}}
+	h.mu.Unlock()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatal(err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("old process survived new instruction")
+	}
+	if e.current() || e.value("next_instruction_revision") != "v2" || e.value("process_state") != "exited" {
+		t.Fatal("instruction acknowledgement incorrect")
+	}
+}
+
+func TestReliabilityHeartbeatDoesNotInventProgress(t *testing.T) {
+	ctx, e, _ := testExecution(t)
+	before := e.value("last_progress_at")
+	e.output()
+	if err := e.publish(ctx, false); err != nil {
+		t.Fatal(err)
+	}
+	if e.value("last_progress_at") != before {
+		t.Fatal("output/heartbeat was called business progress")
+	}
+	if e.value("last_output_at") == nil {
+		t.Fatal("lost output liveness")
+	}
+}
+
+func TestReliabilityJournalFailurePreventsProcessStart(t *testing.T) {
+	ctx, e, h := testExecution(t)
+	if err := os.RemoveAll(e.dir); err != nil {
+		t.Fatal(err)
+	}
+	e.phase(ctx, "running_agent")
+	self, _ := os.Executable()
+	root := t.TempDir()
+	_, _, err := runCmd(ctx, execInvokeOpts{WorkDir: root, Env: []string{"TERM=anet-reliability-fixture"}}, []byte("FAIL_AFTER_EFFECT"), self, "exec")
+	if err == nil {
+		t.Fatal("started despite journal failure")
+	}
+	if _, err := os.Stat(filepath.Join(root, "effect.txt")); !os.IsNotExist(err) {
+		t.Fatal("created side effect")
+	}
+	if h.snapshots[len(h.snapshots)-1]["journal_error"] != true {
+		t.Fatal("lost journal error")
+	}
+}
