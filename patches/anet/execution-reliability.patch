 // TurnMessage is one text message of a Turn. From is "me" or "them".
 type TurnMessage struct {
+	ID          string
 	From        string
 	Body        string
 	Attachments []TurnAttachment
 }
 
+// ExecutionHost is an optional extension of TurnHost. Execution updates are
+// status metadata, not conversation instructions and not proof of business effect.
+type ExecutionHost interface {
+	ExecutionTurn(ix string) (Turn, error)
+	ExecutionStatus(ctx context.Context, ix string, snapshot map[string]any, failed bool) error
+}
+
+// ExecutionReplyHost commits a reply only if the instruction is still current.
+// The kernel checks the revision in the same transaction as the reply/result.
+type ExecutionReplyHost interface {
+	SendExecutionTurn(ctx context.Context, ix, revision, text string, atts []Attachment, final bool, snapshot map[string]any) error
+}
+
+var ErrInstructionSuperseded = errors.New("module: a newer instruction superseded this execution")
+
 // TurnAttachment names a file that came with a message; TurnHost.TurnAttachment
 // reads its bytes.
 type TurnAttachment struct {
