diff --git a/internal/execwork/lock.go b/internal/execwork/lock.go
new file mode 100644
index 0000000..8ea3fc9
--- /dev/null
+++ b/internal/execwork/lock.go
@@ -0,0 +1,37 @@
+package execwork
+
+import (
+	"context"
+	"errors"
+	"os"
+	"time"
+)
+
+var errWorkspaceBusy = errors.New("workspace busy")
+
+// LockRoot serializes modifications in a managed root across nodes/processes.
+// OS locks are released on process death; there is no stale PID file to delete.
+func LockRoot(ctx context.Context, root *os.Root) (func(), error) {
+	f, err := root.OpenFile(".anet-workspace.lock", os.O_CREATE|os.O_RDWR, 0600)
+	if err != nil {
+		return nil, err
+	}
+	for {
+		err = lockWorkspace(f)
+		if err == nil {
+			return func() { _ = f.Close() }, nil
+		}
+		if !errors.Is(err, errWorkspaceBusy) {
+			f.Close()
+			return nil, err
+		}
+		t := time.NewTimer(100 * time.Millisecond)
+		select {
+		case <-ctx.Done():
+			t.Stop()
+			f.Close()
+			return nil, ctx.Err()
+		case <-t.C:
+		}
+	}
+}
