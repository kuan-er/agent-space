--- /dev/null
+++ b/internal/release/maintenance.go
@@ -0,0 +1,17 @@
+package release
+
+// DataEpoch is a release compatibility promise covering ALL persistent node
+// data, config and module state, not just SQLite's user_version. A release that
+// makes any of them unreadable by its predecessor MUST increment this epoch.
+// Automatic updates never cross it; such migrations require an explicit update.
+const DataEpoch = 1
+const MaintenanceProtocol = 1
+
+type MaintenancePolicy struct {
+	Protocol  int `json:"protocol"`
+	DataEpoch int `json:"data_epoch"`
+}
+
+func (m *Manifest) CanAutoUpdate() bool {
+	return m.Maintenance != nil && m.Maintenance.Protocol == MaintenanceProtocol && m.Maintenance.DataEpoch == DataEpoch
+}
