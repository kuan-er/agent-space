diff --git a/internal/daemon/execution.go b/internal/daemon/execution.go
new file mode 100644
index 0000000..a5fda2e
--- /dev/null
+++ b/internal/daemon/execution.go
@@ -0,0 +1,180 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"time"
+
+	"github.com/ANetResearch/ANet/internal/a2ashape"
+	"github.com/ANetResearch/ANet/internal/runtime/interactions"
+	"github.com/ANetResearch/ANet/module"
+)
+
+type executionReplyKey struct{}
+type executionReply struct {
+	ix, revision string
+	snapshot     map[string]any
+}
+
+func checkExecutionRevision(ctx context.Context, tx *interactions.Tx, ix string) error {
+	r, ok := ctx.Value(executionReplyKey{}).(executionReply)
+	if !ok || r.ix != ix {
+		return nil
+	}
+	cur, err := tx.Get(ix)
+	if err != nil {
+		return err
+	}
+	if cur.IsTerminal() {
+		return module.ErrTurnGone
+	}
+	msgs, err := tx.Messages(ix)
+	if err != nil {
+		return err
+	}
+	for i := len(msgs) - 1; i >= 0; i-- {
+		m := msgs[i]
+		if m.SenderAID == cur.PeerAID && m.Kind == interactions.MsgText && !hasControlMeta(m.Metadata) {
+			if m.MsgID == r.revision {
+				return nil
+			}
+			return module.ErrInstructionSuperseded
+		}
+	}
+	return module.ErrInstructionSuperseded
+}
+
+func (p turnPart) SendExecutionTurn(ctx context.Context, ix, revision, text string, atts []module.Attachment, final bool, snapshot map[string]any) error {
+	ctx = context.WithValue(ctx, executionReplyKey{}, executionReply{ix, revision, snapshot})
+	return p.SendTurn(ctx, ix, text, atts, final)
+}
+
+func executionResultMeta(ctx context.Context) []byte {
+	meta := map[string]any{"anet.state": string(interactions.StateCompleted)}
+	if r, ok := ctx.Value(executionReplyKey{}).(executionReply); ok {
+		meta["anet.execution"] = r.snapshot
+	}
+	b, _ := json.Marshal(meta)
+	return b
+}
+
+func (p turnPart) ExecutionTurn(ix string) (module.Turn, error) {
+	th, err := p.d.turnCheck(ix, false)
+	if err != nil {
+		return module.Turn{}, err
+	}
+	return turnOf(th, p.d.readPeers().trusted(th.Peer)), nil
+}
+
+func (p turnPart) ExecutionStatus(ctx context.Context, ix string, snapshot map[string]any, failed bool) error {
+	th, err := p.d.turnCheck(ix, false)
+	if err != nil {
+		return err
+	}
+	if th.Role != string(interactions.RoleInbound) {
+		return nil
+	}
+	state := interactions.StateWorking
+	if snapshot["phase"] == "completed" {
+		// Finishing one execution attempt does not answer the question it
+		// just sent. Preserve input-required instead of reopening working.
+		state = interactions.State(th.State)
+	}
+	meta := map[string]any{"anet.execution": snapshot}
+	if failed {
+		state = interactions.StateFailed
+		meta[a2ashape.KeyReason] = "backend_failed"
+		// An old failure must not terminate a newly revised instruction.
+		revision, _ := snapshot["instruction_revision"].(string)
+		ctx = context.WithValue(ctx, executionReplyKey{}, executionReply{ix, revision, nil})
+	}
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	return p.d.SendStatus(ctx, ix, state, "", meta)
+}
+
+// Derive the timeline from durable signed status messages BEFORE history is
+// shortened for the client. A later success never erases a preceding attempt.
+func executionMetadata(t *a2ashape.Task, msgs []interactions.Message, provider string) {
+	resultSnapshot, _ := t.Metadata["anet.execution"].(map[string]any)
+	var attempts []any
+	index := map[string]int{}
+	for _, msg := range msgs {
+		if (msg.Kind != interactions.MsgStatus && msg.Kind != interactions.MsgText) || msg.SenderAID != provider {
+			continue
+		}
+		var meta map[string]any
+		if json.Unmarshal([]byte(msg.Metadata), &meta) != nil {
+			continue
+		}
+		x, ok := meta["anet.execution"].(map[string]any)
+		if !ok {
+			continue
+		}
+		id, _ := x["attempt_id"].(string)
+		if id == "" {
+			continue
+		}
+		if i, exists := index[id]; exists {
+			attempts[i] = x
+		} else {
+			index[id] = len(attempts)
+			attempts = append(attempts, x)
+		}
+		t.Metadata["anet.execution"] = x
+	}
+	if resultSnapshot != nil {
+		id, _ := resultSnapshot["attempt_id"].(string)
+		if i, ok := index[id]; ok {
+			attempts[i] = resultSnapshot
+		} else {
+			attempts = append(attempts, resultSnapshot)
+		}
+		t.Metadata["anet.execution"] = resultSnapshot
+	}
+	if len(attempts) > 0 {
+		t.Metadata["anet.execution_attempts"] = attempts
+	}
+	if x, ok := t.Metadata["anet.execution"].(map[string]any); ok {
+		// A bounded task read may omit the full timeline. Keep a small,
+		// allowlisted summary so failure/effect uncertainty remains visible.
+		summary := map[string]any{}
+		for _, k := range []string{"attempt_id", "instruction_revision", "phase", "side_effects", "error_category", "heartbeat_at"} {
+			if v, ok := x[k].(string); ok && len(v) <= 64 {
+				summary[k] = v
+			}
+		}
+		if v, ok := x["exit_code"].(float64); ok {
+			summary["exit_code"] = v
+		}
+		t.Metadata["anet.execution_summary"] = summary
+	}
+	business := "not_automatically_verified"
+	if effect, ok := t.Metadata["anet.effect_status"].(string); ok && effect != "" {
+		business = effect // preserve the original skill effect semantics
+	}
+	t.Metadata["anet.business_verification"] = business
+}
+
+func instructionMetadata(t *a2ashape.Task, msgs []interactions.Message, requester string, canceled bool) {
+	for i := len(msgs) - 1; i >= 0; i-- {
+		m := msgs[i]
+		if m.SenderAID != requester || m.Kind != interactions.MsgText || hasControlMeta(m.Metadata) {
+			continue
+		}
+		delivery := "queued"
+		x, _ := t.Metadata["anet.execution"].(map[string]any)
+		if x["instruction_revision"] == m.MsgID {
+			delivery = "delivered_to_executor"
+		} else if x != nil {
+			delivery = "next_turn_pending_stop"
+		}
+		t.Metadata["anet.instruction"] = map[string]any{"revision": m.MsgID, "delivery": delivery}
+		if canceled {
+			// A terminal cancel is a request; it does not prove that a remote
+			// process stopped. Late local acknowledgements cannot reopen A2A.
+			t.Metadata["anet.execution_stop"] = map[string]any{"requested": true, "confirmation": "unconfirmed"}
+		}
+		return
+	}
+}
