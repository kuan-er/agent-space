+package module
+
+// WorkLeaseHost brackets backend activity, including cleanup after a task has
+// become terminal. It grants no execution authority. Maintenance refuses to
+// restart while any lease is held; a false result means retry on a later scan.
+type WorkLeaseHost interface {
+	BeginWork() (done func(), ok bool)
+}
