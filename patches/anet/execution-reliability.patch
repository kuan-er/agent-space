+package daemon
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/ANetResearch/ANet/internal/runtime/interactions"
+	"github.com/ANetResearch/ANet/module"
+)
+
+func TestMaintenanceStandbyHasNoDispatchAndBlocksWrites(t *testing.T) {
+	l := Layout{Root: t.TempDir()}
+	d, err := NewStandby(l)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer d.Close()
+	select {
+	case <-d.ready:
+		t.Fatal("standby ready before activation")
+	default:
+	}
+	if _, ok := (turnPart{d}).BeginWork(); ok {
+		t.Fatal("standby grants work")
+	}
+	if r := d.receiveEnvelope(context.Background(), []byte("untrusted")); r.class != rxTransient {
+		t.Fatalf("standby acknowledged inbound: %+v", r)
+	}
+	called := false
+	h := d.maintenanceRouteGuard("POST /delegate", http.HandlerFunc(func(http.ResponseWriter, *http.Request) { called = true }))
+	w := httptest.NewRecorder()
+	h.ServeHTTP(w, httptest.NewRequest("POST", "/delegate", nil))
+	if called || w.Code != 503 {
+		t.Fatalf("write reached standby: %d", w.Code)
+	}
+	d.ResumeMaintenance()
+	select {
+	case <-d.ready:
+	default:
+		t.Fatal("activation did not open feeds")
+	}
+	done, ok := (turnPart{d}).BeginWork()
+	if !ok {
+		t.Fatal("no lease after activate")
+	}
+	if d.PrepareMaintenance() == nil {
+		t.Fatal("restarting during backend cleanup")
+	}
+	done()
+	done() // release is idempotent
+	if err := d.PrepareMaintenance(); err != nil {
+		t.Fatal(err)
+	}
+	if _, ok := (turnPart{d}).BeginWork(); ok {
+		t.Fatal("raced with restart")
+	}
+}
+
+func TestMaintenanceUnfinishedTasksBlockRestart(t *testing.T) {
+	srv := newFakeHub(t)
+	prov, req := registered(t, srv.URL, "prov"), registered(t, srv.URL, "req")
+	allowPeers(t, prov, req.AID())
+	_, err := req.Delegate(context.Background(), prov.AID(), "do work", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = prov.pollOnce(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if err = prov.PrepareMaintenance(); err == nil {
+		t.Fatal("stopped with unfinished work")
+	}
+	list, err := prov.ix.ListAll(interactions.ListFilter{Active: true})
+	if err != nil || len(list) == 0 {
+		t.Fatal("missing task")
+	}
+	if prov.MaintenanceStatus().Held {
+		t.Fatal("busy check left admission blocked")
+	}
+	// Legacy backend failures waited for input. Keep them paused across the
+	// upgrade; neither feed may replay the same user message after restart.
+	id := list[0].ID
+	if _, err = prov.ix.SetState(id, interactions.StateInputRequired, interactions.CauseNotTerminal); err != nil {
+		t.Fatal(err)
+	}
+	if turns, err := (turnPart{prov}).OwedTurns(context.Background()); err != nil {
+		t.Fatal(err)
+	} else {
+		for _, turn := range turns {
+			if turn.Ix == id {
+				t.Fatal("waiting task replayed")
+			}
+		}
+	}
+	if err = prov.PrepareMaintenance(); err != nil {
+		t.Fatalf("paused task blocks update: %v", err)
+	}
+	prov.ResumeMaintenance()
+	if stateOnMessage(true, interactions.MsgText, nil, "") != interactions.StateWorking {
+		t.Fatal("new input cannot resume")
+	}
+}
+
+func TestMaintenanceBackendHostsBracketWork(t *testing.T) {
+	d, err := New(Layout{Root: t.TempDir()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer d.Close()
+	for _, name := range []string{"autoreply", "a2a"} {
+		h, _ := newModuleHost(d, name)
+		lease, ok := h.(module.WorkLeaseHost)
+		if !ok {
+			t.Fatalf("%s cannot report work", name)
+		}
+		done, ok := lease.BeginWork()
+		if !ok {
+			t.Fatal(name)
+		}
+		if d.PrepareMaintenance() == nil {
+			t.Fatalf("%s activity ignored", name)
+		}
+		done()
+	}
+}
