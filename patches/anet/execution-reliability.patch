diff --git a/internal/daemon/maintenance.go b/internal/daemon/maintenance.go
new file mode 100644
index 0000000..d054033
--- /dev/null
+++ b/internal/daemon/maintenance.go
@@ -0,0 +1,114 @@
+package daemon
+
+import (
+	"errors"
+	"net/http"
+	"os"
+	"strings"
+	"sync"
+
+	"github.com/ANetResearch/ANet/internal/release"
+	"github.com/ANetResearch/ANet/internal/runtime/interactions"
+)
+
+var errMaintaining = errors.New("anet: node is preparing an update; retry later")
+
+// The gate is a counter, not a recursively acquired RWMutex: a control request
+// can enter the task seam, and a received envelope can invoke a capability.
+type maintenanceGate struct {
+	mu    sync.Mutex
+	held  bool
+	users int
+}
+
+func (g *maintenanceGate) enter() (func(), bool) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.held {
+		return nil, false
+	}
+	g.users++
+	var once sync.Once
+	return func() { once.Do(func() { g.mu.Lock(); g.users--; g.mu.Unlock() }) }, true
+}
+
+func (p turnPart) BeginWork() (func(), bool)        { return p.d.maintenance.enter() }
+func (p inboundTaskPart) BeginWork() (func(), bool) { return p.d.maintenance.enter() }
+
+// MaintenanceStatus is local supervisor IPC, never remote task metadata.
+type MaintenanceStatus struct {
+	Protocol  int    `json:"protocol"`
+	DataEpoch int    `json:"data_epoch"`
+	PID       int    `json:"pid"`
+	Version   string `json:"version"`
+	Commit    string `json:"commit"`
+	Serving   bool   `json:"serving"`
+	Held      bool   `json:"held"`
+	Active    int    `json:"active"`
+	Reason    string `json:"reason,omitempty"`
+}
+
+func (d *Daemon) MaintenanceStatus() MaintenanceStatus {
+	d.maintenance.mu.Lock()
+	defer d.maintenance.mu.Unlock()
+	return MaintenanceStatus{Protocol: release.MaintenanceProtocol, DataEpoch: release.DataEpoch,
+		PID: os.Getpid(), Version: Version, Commit: BuildCommit,
+		Serving: d.controlServing.Load(), Held: d.maintenance.held, Active: d.maintenance.users}
+}
+
+// PrepareMaintenance closes admission atomically with the idle check. It never
+// cancels work. Waiting-input rows are paused until new input and do not block;
+// backend leases still block even after a task changes state. On a busy/error
+// result the gate is reopened immediately.
+func (d *Daemon) PrepareMaintenance() error {
+	d.maintenance.mu.Lock()
+	defer d.maintenance.mu.Unlock()
+	if d.maintenance.held {
+		return nil
+	}
+	if d.maintenance.users != 0 {
+		return errors.New("backend or request still active")
+	}
+	d.maintenance.held = true
+	list, err := d.ix.ListAll(interactions.ListFilter{Active: true})
+	blocking := 0
+	for _, ix := range list {
+		if ix.State != interactions.StateInputRequired {
+			blocking++
+		}
+	}
+	if err != nil || blocking != 0 {
+		d.maintenance.held = false
+		if err != nil {
+			return errors.New("cannot confirm task store is idle")
+		}
+		return errors.New("unfinished tasks still exist")
+	}
+	return nil
+}
+
+// ResumeMaintenance also commits a standby startup. Until this call the core
+// has no relay/outbox loops and neither backend feed can dispatch a task.
+func (d *Daemon) ResumeMaintenance() {
+	d.maintenance.mu.Lock()
+	d.maintenance.held = false
+	d.maintenance.mu.Unlock()
+	d.activateOnce.Do(d.activate)
+	d.kickTurns()
+}
+
+func (d *Daemon) maintenanceRouteGuard(pattern string, h http.Handler) http.Handler {
+	h = d.moduleRouteGuard(pattern, h)
+	if strings.HasSuffix(pattern, " /status") || strings.HasSuffix(pattern, " /shutdown") {
+		return h
+	}
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		done, ok := d.maintenance.enter()
+		if !ok {
+			writeJSON(w, http.StatusServiceUnavailable, map[string]string{"error": "maintenance_in_progress"})
+			return
+		}
+		defer done()
+		h.ServeHTTP(w, r)
+	})
+}
