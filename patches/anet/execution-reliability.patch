new file mode 100644
index 0000000..7a7df8f
--- /dev/null
+++ b/internal/execwork/lock_test.go
@@ -0,0 +1,32 @@
+package execwork
+
+import (
+	"context"
+	"errors"
+	"os"
+	"testing"
+	"time"
+)
+
+func TestWorkspaceLockSerializesAndCanBeCanceled(t *testing.T) {
+	r, err := os.OpenRoot(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer r.Close()
+	unlock, err := LockRoot(context.Background(), r)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
+	defer cancel()
+	if _, err = LockRoot(ctx, r); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("second writer entered: %v", err)
+	}
+	unlock()
+	unlock, err = LockRoot(context.Background(), r)
+	if err != nil {
+		t.Fatal(err)
+	}
+	unlock()
+}
diff --git a/internal/execwork/lock_unix.go b/internal/execwork/lock_unix.go
new file mode 100644
index 0000000..b2dddd7
--- /dev/null
+++ b/internal/execwork/lock_unix.go
@@ -0,0 +1,17 @@
+//go:build unix
+
+package execwork
+
+import (
+	"errors"
+	"os"
+	"syscall"
+)
+
+func lockWorkspace(f *os.File) error {
+	err := syscall.Flock(int(f.Fd()), syscall.LOCK_EX|syscall.LOCK_NB)
+	if errors.Is(err, syscall.EWOULDBLOCK) || errors.Is(err, syscall.EINTR) {
+		return errWorkspaceBusy
+	}
+	return err
+}
diff --git a/internal/execwork/lock_windows.go b/internal/execwork/lock_windows.go
new file mode 100644
index 0000000..49f50fb
--- /dev/null
+++ b/internal/execwork/lock_windows.go
@@ -0,0 +1,17 @@
+//go:build windows
+
+package execwork
+
+import (
+	"errors"
+	"golang.org/x/sys/windows"
+	"os"
+)
+
+func lockWorkspace(f *os.File) error {
+	err := windows.LockFileEx(windows.Handle(f.Fd()), windows.LOCKFILE_EXCLUSIVE_LOCK|windows.LOCKFILE_FAIL_IMMEDIATELY, 0, 1, 0, &windows.Overlapped{})
+	if errors.Is(err, windows.ERROR_LOCK_VIOLATION) || errors.Is(err, windows.ERROR_IO_PENDING) {
+		return errWorkspaceBusy
+	}
+	return err
+}
diff --git a/internal/maintenance/prune.go b/internal/maintenance/prune.go
new file mode 100644
index 0000000..dfd95f8
--- /dev/null
+++ b/internal/maintenance/prune.go
@@ -0,0 +1,38 @@
+package maintenance
+
+import (
+	"os"
+	"path/filepath"
+)
+
+// Prune keeps the current/previous runtime and the pending candidate. Failed
+// digests remain quarantined in state, but their executables need not consume
+// disk forever. It never follows directory symlinks or touches the launcher.
+func (s Store) Prune(st State) {
+	keep := map[string]bool{st.Current.SHA256: true}
+	if st.Previous != nil {
+		keep[st.Previous.SHA256] = true
+	}
+	if st.Pending != nil {
+		keep[st.Pending.SHA256] = true
+	}
+	root := filepath.Join(s.Dir, "versions")
+	entries, err := os.ReadDir(root)
+	if err != nil {
+		return
+	}
+	for _, e := range entries {
+		if !e.IsDir() || keep[e.Name()] || len(e.Name()) != 64 {
+			continue
+		}
+		valid := true
+		for _, c := range e.Name() {
+			if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
+				valid = false
+			}
+		}
+		if valid {
+			_ = os.RemoveAll(filepath.Join(root, e.Name()))
+		}
+	}
+}
diff --git a/internal/maintenance/store.go b/internal/maintenance/store.go
new file mode 100644
index 0000000..5e86d6e
--- /dev/null
+++ b/internal/maintenance/store.go
@@ -0,0 +1,135 @@
+// Package maintenance owns per-node runtime slots. It never replaces the shared
+// CLI/launcher, edits agent settings, or retries a business task.
+package maintenance
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"time"
+
+	"github.com/ANetResearch/ANet/internal/fsperm"
+	"github.com/ANetResearch/ANet/internal/release"
+)
+
+type Config struct {
+	Enabled  bool   `json:"enabled"`
+	Interval string `json:"interval"`
+	Base     string `json:"base,omitempty"`
+}
+
+func (c Config) Duration() (time.Duration, error) {
+	d, err := time.ParseDuration(c.Interval)
+	if err != nil || d < 15*time.Minute || d > 7*24*time.Hour {
+		return 0, errors.New("interval must be between 15m and 168h")
+	}
+	return d, nil
+}
+
+type Runtime struct {
+	Path    string `json:"path"`
+	Version string `json:"version"`
+	Commit  string `json:"commit"`
+	SHA256  string `json:"sha256,omitempty"`
+}
+
+type State struct {
+	Schema     int               `json:"schema"`
+	Phase      string            `json:"phase"`
+	Current    Runtime           `json:"current"`
+	Previous   *Runtime          `json:"previous,omitempty"`
+	Pending    *Runtime          `json:"pending,omitempty"`
+	Quarantine map[string]string `json:"quarantine,omitempty"`
+	LastCheck  time.Time         `json:"last_check,omitempty"`
+	NextCheck  time.Time         `json:"next_check,omitempty"`
+	UpdatedAt  time.Time         `json:"updated_at"`
+	Reason     string            `json:"reason,omitempty"`
+}
+
+type Store struct{ Dir string }
+
+func (s Store) Init() error { return os.MkdirAll(s.Dir, 0700) }
+func (s Store) Read(name string, out any) error {
+	b, err := os.ReadFile(filepath.Join(s.Dir, name))
+	if err != nil {
+		return err
+	}
+	if len(b) > 1<<20 {
+		return errors.New("maintenance record too large")
+	}
+	return json.Unmarshal(b, out)
+}
+
+func (s Store) Write(name string, value any) error {
+	if err := s.Init(); err != nil {
+		return err
+	}
+	b, err := json.MarshalIndent(value, "", "  ")
+	if err != nil {
+		return err
+	}
+	f, err := os.CreateTemp(s.Dir, ".record-*")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(f.Name())
+	if _, err = f.Write(append(b, '\n')); err == nil {
+		err = f.Sync()
+	}
+	if e := f.Close(); err == nil {
+		err = e
+	}
+	if err != nil {
+		return err
+	}
+	if err = fsperm.ReplaceFile(f.Name(), filepath.Join(s.Dir, name)); err != nil {
+		return err
+	}
+	if dir, e := os.Open(s.Dir); e == nil {
+		_ = dir.Sync()
+		_ = dir.Close()
+	}
+	return nil
+}
+
+func (s Store) Config(defaultEnabled bool) (Config, error) {
+	c := Config{Enabled: defaultEnabled, Interval: "6h"}
+	err := s.Read("config.json", &c)
+	if errors.Is(err, os.ErrNotExist) {
+		err = nil
+	}
+	if err != nil {
+		return c, err
+	}
+	if _, err = c.Duration(); err != nil {
+		return c, err
+	}
+	if c.Base != "" {
+		_, err = release.BaseSource(c.Base)
+	}
+	return c, err
+}
+
+func (s Store) Save(st *State, phase, reason string) error {
+	st.Schema, st.Phase, st.Reason, st.UpdatedAt = 1, phase, reason, time.Now().UTC()
+	if err := s.Write("state.json", st); err != nil {
+		return err
+	}
+	// Events are a separate append-only attempt timeline, not overwritten by
+	// eventual success. No URLs, tokens, request bodies or backend output.
+	f, err := os.OpenFile(filepath.Join(s.Dir, "events.jsonl"), os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0600)
+	if err != nil {
+		return err
+	}
+	b, _ := json.Marshal(map[string]any{"at": st.UpdatedAt, "phase": phase, "reason": reason, "version": st.Current.Version, "pending": st.Pending})
+	_, err = fmt.Fprintln(f, string(b))
+	if err == nil {
+		err = f.Sync()
+	}
+	if e := f.Close(); err == nil {
+		err = e
+	}
+	return err
+}
diff --git a/internal/maintenance/supervisor.go b/internal/maintenance/supervisor.go
new file mode 100644
index 0000000..d826865
--- /dev/null
+++ b/internal/maintenance/supervisor.go
@@ -0,0 +1,351 @@
+package maintenance
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"time"
+
+	"github.com/ANetResearch/ANet/internal/release"
+)
+
+// Child talks only over inherited pipes. No network endpoint, credential or
+// command shell is involved in the supervisor/daemon protocol.
+type Health struct {
+	Protocol  int    `json:"protocol"`
+	DataEpoch int    `json:"data_epoch"`
+	PID       int    `json:"pid"`
+	Version   string `json:"version"`
+	Commit    string `json:"commit"`
+	Serving   bool   `json:"serving"`
+	Held      bool   `json:"held"`
+	Reason    string `json:"reason,omitempty"`
+}
+
+type Child interface {
+	Call(context.Context, string) (Health, error)
+	Done() <-chan struct{}
+	Err() error // only after Done
+	Close()     // releases the parent's pipe handles, never kills an active child
+}
+
+type Supervisor struct {
+	Store          Store
+	Initial        Runtime
+	DefaultEnabled bool
+	Start          func(Runtime) (Child, error)
+	Check          func(context.Context, Config, Runtime) (*Runtime, error)
+	Tick           time.Duration
+	HealthWait     time.Duration
+	StableFor      time.Duration
+	StopWait       time.Duration
+}
+
+func (s *Supervisor) health(ctx context.Context, c Child, target Runtime) error {
+	ctx, cancel := context.WithTimeout(ctx, s.HealthWait)
+	defer cancel()
+	var since time.Time
+	for {
+		h, err := c.Call(ctx, "health")
+		if err != nil {
+			return err
+		}
+		if h.Protocol != release.MaintenanceProtocol || h.DataEpoch != release.DataEpoch || h.Version != target.Version || h.Commit != target.Commit || !h.Held {
+			return errors.New("standby identity or protocol mismatch")
+		}
+		if h.Serving {
+			if since.IsZero() {
+				since = time.Now()
+			}
+			if time.Since(since) >= s.StableFor {
+				return nil
+			}
+		} else {
+			since = time.Time{}
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-c.Done():
+			return errors.New("standby exited")
+		case <-time.After(100 * time.Millisecond):
+		}
+	}
+}
+
+func (s *Supervisor) stop(ctx context.Context, c Child) error {
+	ctx, cancel := context.WithTimeout(ctx, s.StopWait)
+	defer cancel()
+	_, _ = c.Call(ctx, "shutdown")
+	select {
+	case <-c.Done():
+		c.Close()
+		return nil
+	case <-ctx.Done():
+		return errors.New("stop unconfirmed; no replacement was started")
+	}
+}
+
+// switchRuntime leaves old serving until the candidate is fully downloaded.
+// Prepare is an atomic gate+idle check. The WAL is durable before old exits.
+// A candidate is committed before activate; after activate no rollback/replay
+// is attempted, since it may already have produced business effects.
+func (s *Supervisor) switchRuntime(ctx context.Context, st *State, old Child, target Runtime) (Child, error) {
+	h, err := old.Call(ctx, "prepare")
+	if err != nil {
+		return old, err
+	}
+	if !h.Held {
+		return old, s.Store.Save(st, "waiting_idle", h.Reason)
+	}
+	st.Pending = &target
+	if err = s.Store.Save(st, "switching", ""); err != nil {
+		_, _ = old.Call(ctx, "resume")
+		return old, err
+	}
+	if err = s.stop(ctx, old); err != nil {
+		return old, err
+	}
+	next, err := s.Start(target)
+	if err == nil {
+		err = s.health(ctx, next, target)
+	}
+	if err != nil {
+		if next != nil {
+			if stopErr := s.stop(ctx, next); stopErr != nil {
+				return next, stopErr
+			}
+		}
+		if st.Quarantine == nil {
+			st.Quarantine = map[string]string{}
+		}
+		st.Quarantine[target.SHA256] = "standby_health_failed"
+		st.Pending = nil
+		if e := s.Store.Save(st, "rolled_back", "standby_health_failed"); e != nil {
+			return nil, e
+		}
+		restored, e := s.Start(st.Current)
+		if e == nil {
+			e = s.health(ctx, restored, st.Current)
+		}
+		if e == nil {
+			_, e = restored.Call(ctx, "activate")
+		}
+		return restored, e
+	}
+	previous := st.Current
+	st.Previous, st.Current, st.Pending = &previous, target, nil
+	if err = s.Store.Save(st, "committed", ""); err != nil {
+		_ = s.stop(ctx, next)
+		return nil, err
+	}
+	if _, err = next.Call(ctx, "activate"); err != nil {
+		return next, err
+	}
+	return next, s.Store.Save(st, "running", "")
+}
+
+func (s *Supervisor) Run(ctx context.Context) error {
+	if s.Tick == 0 {
+		s.Tick = 30 * time.Second
+	}
+	if s.HealthWait == 0 {
+		s.HealthWait = 30 * time.Second
+	}
+	if s.StableFor == 0 {
+		s.StableFor = time.Second
+	}
+	if s.StopWait == 0 {
+		s.StopWait = 60 * time.Second
+	}
+	st := State{Schema: 1, Current: s.Initial}
+	if err := s.Store.Read("state.json", &st); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	// A manually replaced shared launcher changes its own bootstrap runtime.
+	// Installed runtime slots remain pinned even when updates are disabled.
+	if st.Current.Path == s.Initial.Path && st.Current.SHA256 == "" {
+		st.Current = s.Initial
+	}
+	if st.Schema != 1 {
+		return errors.New("unsupported maintenance state schema")
+	}
+	if st.Pending != nil {
+		if st.Quarantine == nil {
+			st.Quarantine = map[string]string{}
+		}
+		st.Quarantine[st.Pending.SHA256] = "interrupted_before_commit"
+		st.Pending = nil
+		if err := s.Store.Save(&st, "rolled_back", "interrupted_before_commit"); err != nil {
+			return err
+		}
+	}
+	child, err := s.Start(st.Current)
+	if err != nil {
+		return err
+	}
+	defer func() {
+		if child != nil {
+			child.Close()
+		}
+	}()
+	if err = s.health(ctx, child, st.Current); err != nil {
+		_ = s.stop(ctx, child)
+		return err
+	}
+	if _, err = child.Call(ctx, "activate"); err != nil {
+		return err
+	}
+	if err = s.Store.Save(&st, "running", ""); err != nil {
+		return err
+	}
+	tick := time.NewTicker(s.Tick)
+	defer tick.Stop()
+	type checked struct {
+		target *Runtime
+		err    error
+	}
+	checks := make(chan checked, 1)
+	checking := false
+	var pending *Runtime
+	crashes := 0
+	for {
+		select {
+		case <-ctx.Done():
+			// A supervisor shutdown requests the ordinary daemon shutdown.
+			// It never kills an agent process by PID or retries its task.
+			return s.stop(context.Background(), child)
+		case <-child.Done():
+			if child.Err() == nil {
+				return s.Store.Save(&st, "stopped", "operator_or_clean_shutdown")
+			}
+			crashes++
+			if err = s.Store.Save(&st, "restart_backoff", "daemon_exited"); err != nil {
+				return err
+			}
+			backoff := time.Duration(min(crashes, 10)) * 30 * time.Second
+			select {
+			case <-ctx.Done():
+				return ctx.Err()
+			case <-time.After(backoff):
+			}
+			child.Close()
+			child, err = s.Start(st.Current)
+			if err != nil {
+				return err
+			}
+			if err = s.health(ctx, child, st.Current); err != nil {
+				_ = s.stop(ctx, child)
+				return err
+			}
+			if _, err = child.Call(ctx, "activate"); err != nil {
+				return err
+			}
+		case result := <-checks:
+			checking = false
+			pending = result.target
+			if result.err != nil {
+				st.NextCheck = time.Now().Add(30 * time.Minute)
+				if err = s.Store.Save(&st, "check_failed", failureReason(result.err)); err != nil {
+					return err
+				}
+			} else if pending == nil {
+				if err = s.Store.Save(&st, "current", ""); err != nil {
+					return err
+				}
+			} else if st.Quarantine[pending.SHA256] != "" {
+				pending = nil
+				s.Store.Prune(st)
+				if err = s.Store.Save(&st, "quarantined", "previous_health_failure"); err != nil {
+					return err
+				}
+			}
+		case <-tick.C:
+			cfg, e := s.Store.Config(s.DefaultEnabled)
+			if e != nil {
+				return e
+			}
+			if !cfg.Enabled {
+				pending = nil
+				continue
+			}
+			if pending != nil {
+				child, err = s.switchRuntime(ctx, &st, child, *pending)
+				if err != nil {
+					return err
+				}
+				if st.Current.SHA256 == pending.SHA256 || st.Quarantine[pending.SHA256] != "" {
+					pending = nil
+					s.Store.Prune(st)
+				}
+				continue
+			}
+			request := filepath.Join(s.Store.Dir, "check.request")
+			_, requested := os.Stat(request)
+			if !checking && (requested == nil || !time.Now().Before(st.NextCheck)) {
+				_ = os.Remove(request)
+				interval, _ := cfg.Duration()
+				st.LastCheck, st.NextCheck = time.Now().UTC(), time.Now().Add(interval)
+				if err = s.Store.Save(&st, "checking", ""); err != nil {
+					return err
+				}
+				checking = true
+				current := st.Current
+				go func() {
+					bounded, cancel := context.WithTimeout(ctx, 10*time.Minute)
+					defer cancel()
+					r, e := s.Check(bounded, cfg, current)
+					select {
+					case checks <- checked{r, e}:
+					case <-ctx.Done():
+					}
+				}()
+			}
+		}
+	}
+}
+
+func ValidateRuntime(root string, r Runtime, initial Runtime) error {
+	if r == initial {
+		return nil
+	}
+	// Runtime slots are content-addressed, not arbitrary executable paths
+	// selected by a peer or a version string.
+	if len(r.SHA256) != 64 {
+		return errors.New("invalid runtime digest")
+	}
+	for _, c := range r.SHA256 {
+		if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
+			return errors.New("invalid runtime digest")
+		}
+	}
+	want := filepath.Join(root, "versions", r.SHA256, filepath.Base(initial.Path))
+	if r.Path != want {
+		return fmt.Errorf("runtime is outside its maintenance slot")
+	}
+	return nil
+}
+
+// Refusal is a public diagnostic code; it never contains a URL, credential or
+// backend stderr. Other errors receive a bounded generic description.
+type Refusal string
+
+func (r Refusal) Error() string { return string(r) }
+func failureReason(err error) string {
+	var r Refusal
+	if errors.As(err, &r) {
+		return string(r)
+	}
+	if errors.Is(err, release.ErrExpired) {
+		return "release_manifest_expired"
+	}
+	if errors.Is(err, release.ErrUnverified) {
+		return "release_signature_unverified"
+	}
+	if errors.Is(err, context.DeadlineExceeded) {
+		return "release_download_timeout"
+	}
+	return "release_check_or_staging_failed"
+}
diff --git a/internal/maintenance/supervisor_test.go b/internal/maintenance/supervisor_test.go
new file mode 100644
index 0000000..3cc6f7b
--- /dev/null
+++ b/internal/maintenance/supervisor_test.go
@@ -0,0 +1,164 @@
+package maintenance
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/ANetResearch/ANet/internal/release"
+)
+
+type fakeChild struct {
+	r                          Runtime
+	held, busy, bad, activated bool
+	done                       chan struct{}
+	once                       sync.Once
+	actions                    []string
+	onActivate                 func()
+}
+
+func fake(r Runtime) *fakeChild { return &fakeChild{r: r, held: true, done: make(chan struct{})} }
+func (c *fakeChild) Call(_ context.Context, a string) (Health, error) {
+	c.actions = append(c.actions, a)
+	if c.bad && a == "health" {
+		return Health{}, errors.New("candidate crashed")
+	}
+	switch a {
+	case "prepare":
+		c.held = !c.busy
+	case "activate", "resume":
+		c.held = false
+		c.activated = true
+		if c.onActivate != nil {
+			c.onActivate()
+		}
+	case "shutdown":
+		c.once.Do(func() { close(c.done) })
+	}
+	return Health{Protocol: release.MaintenanceProtocol, DataEpoch: release.DataEpoch, Version: c.r.Version, Commit: c.r.Commit, Serving: true, Held: c.held, Reason: "busy"}, nil
+}
+func (c *fakeChild) Done() <-chan struct{} { return c.done }
+func (c *fakeChild) Err() error            { return nil }
+func (c *fakeChild) Close()                {}
+
+func testSupervisor(t *testing.T) (*Supervisor, *State, *fakeChild, Runtime) {
+	t.Helper()
+	old := Runtime{Path: "old", Version: "1.0.0", Commit: "old", SHA256: "old"}
+	target := Runtime{Path: "new", Version: "1.0.1", Commit: "new", SHA256: "new"}
+	s := &Supervisor{Store: Store{Dir: t.TempDir()}, Initial: old, HealthWait: time.Second, StableFor: time.Nanosecond, StopWait: time.Second}
+	c := fake(old)
+	c.held = false
+	return s, &State{Schema: 1, Current: old}, c, target
+}
+
+func TestMaintenanceBusyNeverStopsOrStarts(t *testing.T) {
+	s, st, c, target := testSupervisor(t)
+	c.busy = true
+	s.Start = func(Runtime) (Child, error) { t.Fatal("started while busy"); return nil, nil }
+	got, err := s.switchRuntime(context.Background(), st, c, target)
+	if err != nil || got != c || st.Phase != "waiting_idle" || len(c.actions) != 1 || c.actions[0] != "prepare" {
+		t.Fatalf("%+v %v %v", st, c.actions, err)
+	}
+}
+
+func TestMaintenanceCommitIsDurableBeforeActivation(t *testing.T) {
+	s, st, c, target := testSupervisor(t)
+	next := fake(target)
+	next.onActivate = func() {
+		var disk State
+		if err := s.Store.Read("state.json", &disk); err != nil || disk.Current != target || disk.Pending != nil || disk.Previous == nil {
+			t.Fatalf("activation before commit: %+v %v", disk, err)
+		}
+	}
+	s.Start = func(r Runtime) (Child, error) {
+		select {
+		case <-c.Done():
+		default:
+			t.Fatal("old process still alive")
+		}
+		return next, nil
+	}
+	got, err := s.switchRuntime(context.Background(), st, c, target)
+	if err != nil || got != next || !next.activated || st.Phase != "running" {
+		t.Fatalf("%+v %v", st, err)
+	}
+}
+
+func TestMaintenanceBadCandidateRollsBackAndQuarantines(t *testing.T) {
+	s, st, c, target := testSupervisor(t)
+	bad := fake(target)
+	bad.bad = true
+	restored := fake(st.Current)
+	s.Start = func(r Runtime) (Child, error) {
+		if r == target {
+			return bad, nil
+		}
+		return restored, nil
+	}
+	got, err := s.switchRuntime(context.Background(), st, c, target)
+	if err != nil || got != restored || !restored.activated || bad.activated || st.Current == target || st.Quarantine[target.SHA256] == "" {
+		t.Fatalf("unsafe rollback: %+v %v", st, err)
+	}
+	select {
+	case <-bad.Done():
+	default:
+		t.Fatal("failed candidate not stopped")
+	}
+}
+
+func TestMaintenanceFailedJournalLeavesOldServing(t *testing.T) {
+	s, st, c, target := testSupervisor(t)
+	file := filepath.Join(t.TempDir(), "not-directory")
+	_ = os.WriteFile(file, []byte("x"), 0600)
+	s.Store.Dir = file
+	s.Start = func(Runtime) (Child, error) { t.Fatal("started after journal failure"); return nil, nil }
+	_, err := s.switchRuntime(context.Background(), st, c, target)
+	if err == nil || c.held {
+		t.Fatalf("old node was not resumed: %v", err)
+	}
+	select {
+	case <-c.Done():
+		t.Fatal("old stopped")
+	default:
+	}
+}
+
+func TestMaintenanceInterruptedSwitchRestoresPreviousOnBoot(t *testing.T) {
+	s, st, _, target := testSupervisor(t)
+	st.Pending = &target
+	if err := s.Store.Save(st, "switching", ""); err != nil {
+		t.Fatal(err)
+	}
+	child := fake(st.Current)
+	child.onActivate = func() { child.once.Do(func() { close(child.done) }) }
+	s.Start = func(r Runtime) (Child, error) {
+		if r != st.Current {
+			t.Fatal("booted interrupted candidate")
+		}
+		return child, nil
+	}
+	s.DefaultEnabled = false
+	if err := s.Run(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	var disk State
+	if err := s.Store.Read("state.json", &disk); err != nil || disk.Quarantine[target.SHA256] == "" || disk.Pending != nil {
+		t.Fatalf("%+v %v", disk, err)
+	}
+}
+
+func TestMaintenanceConfigBoundsAndRuntimePath(t *testing.T) {
+	for _, v := range []string{"1s", "0", "999h", "bad"} {
+		if _, e := (Config{Interval: v}).Duration(); e == nil {
+			t.Fatal(v)
+		}
+	}
+	i := Runtime{Path: "/bin/anet"}
+	if ValidateRuntime("/node", Runtime{Path: "/untrusted/agent", SHA256: "../escape"}, i) == nil {
+		t.Fatal("accepted escaped runtime")
+	}
+}
