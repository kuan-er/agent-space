+			// A same-task follow-up cannot reroute an existing binding.
+			if _, err = r.Reply(context.Background(), replyContext{InteractionID: "task-one"}, []chatTurn{{Role: "user", Text: "NEW_PROJECT"}}); err != nil {
+				t.Fatal(err)
+			}
