+			if _, err = r.Reply(context.Background(), replyContext{InteractionID: "task-two"}, []chatTurn{{Role: "user", Text: "NEW_PROJECT"}}); err != nil {
+				t.Fatal(err)
+			}
+			if _, err = os.Stat(filepath.Join(root, "projects", "another", "executed.txt")); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+
+func TestReliabilityProjectEscapeAndAmbiguity(t *testing.T) {
+	for _, text := range []string{"BAD_PROJECT", "AMBIGUOUS"} {
