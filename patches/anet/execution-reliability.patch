@@ -0,0 +1,49 @@
+package autoreply
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+
+	"github.com/ANetResearch/ANetCore/delegation"
+)
+
+// A backend may describe tests/screenshots, but that is a claim rather than an
+// independent business verifier. File digests below are computed by the node.
+type reportedEvidence struct {
+	Kind     string `json:"kind"`
+	File     string `json:"file,omitempty"`
+	Scope    string `json:"scope"`
+	ExitCode *int   `json:"exit_code,omitempty"`
+}
+
+func resultEvidence(atts []delegation.Attachment) ([]map[string]any, error) {
+	var out []map[string]any
+	files := map[string]bool{}
+	for _, a := range atts {
+		files[a.Name] = true
+	}
+	for _, a := range atts {
+		h := sha256.Sum256(a.Data)
+		out = append(out, map[string]any{"kind": "file", "name": a.Name, "cid": a.CID, "size": a.Size, "sha256": hex.EncodeToString(h[:]), "verification_scope": "content_integrity_only"})
+		if a.Name != "anet-evidence.json" {
+			continue
+		}
+		var claims []reportedEvidence
+		if len(a.Data) > 16384 || json.Unmarshal(a.Data, &claims) != nil || len(claims) > 32 {
+			return nil, fmt.Errorf("outbox: invalid anet-evidence.json")
+		}
+		for _, c := range claims {
+			if (c.Kind != "test" && c.Kind != "screenshot" && c.Kind != "check") || len(c.Scope) == 0 || len(c.Scope) > 1024 || (c.File != "" && !files[c.File]) {
+				return nil, fmt.Errorf("outbox: invalid or missing evidence reference")
+			}
+			item := map[string]any{"kind": c.Kind, "file": c.File, "scope": c.Scope, "verification": "reported_by_backend"}
+			if c.ExitCode != nil {
+				item["exit_code"] = *c.ExitCode
+			}
+			out = append(out, item)
+		}
+	}
+	return out, nil
+}
