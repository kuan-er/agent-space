--- /dev/null
+++ b/internal/clientinput/contract.go
@@ -0,0 +1,35 @@
+package clientinput
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+
+	"github.com/ANetResearch/ANet/internal/a2ashape"
+)
+
+const MessageIDGuide = "message_id is an optional retry key (CLI: --message-id). Use a fresh random id (a UUID) for each new message. On an open task, an identical retry to the same recipient and conversation/task returns the existing task; changed content under that key is rejected. After a task ends, reusing the key can create a NEW task: only an unanswered call that may have run has a narrow 10-minute retry window from task end. Read the known task before retrying; this is not an exactly-once guarantee for external effects."
+
+// SetMessageID keeps both CLI forms aligned with the MCP message construction.
+func SetMessageID(body map[string]any, id string) {
+	if id == "" {
+		return
+	}
+	if m, ok := body["message"].(a2ashape.Message); ok {
+		m.ID = id
+		body["message"] = m
+	} else {
+		body["message_id"] = id
+	}
+}
+
+func Markdown() string {
+	var b strings.Builder
+	b.WriteString("## Send interface (generated from the MCP input definition)\n\n" + MessageIDGuide + "\n\n| Field | Meaning |\n|---|---|\n")
+	t := reflect.TypeOf(Send{})
+	for i := 0; i < t.NumField(); i++ {
+		f := t.Field(i)
+		fmt.Fprintf(&b, "| `%s` | %s |\n", strings.Split(f.Tag.Get("json"), ",")[0], strings.ReplaceAll(f.Tag.Get("jsonschema"), "|", "/"))
+	}
+	return b.String()
+}
