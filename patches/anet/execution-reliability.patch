new file mode 100644
index 0000000..9e8662b
--- /dev/null
+++ b/module/autoreply/execution.go
@@ -0,0 +1,380 @@
+package autoreply
+
+import (
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/ANetResearch/ANet/module"
+)
+
+type executionKey struct{}
+
+var errInstructionSuperseded = errors.New("execution superseded by a newer instruction")
+
+type execution struct {
+	mu                sync.Mutex
+	pub               sync.Mutex
+	host              module.ExecutionHost
+	ix, revision, dir string
+	snapshot          map[string]any
+	seq               int
+	started           bool
+	superseded        bool
+	trace             []map[string]any
+	lastPhase         string
+}
+
+func instructionRevision(th module.Turn) string {
+	for i := len(th.Messages) - 1; i >= 0; i-- {
+		m := th.Messages[i]
+		if m.From != "them" {
+			continue
+		}
+		if m.ID != "" {
+			return m.ID
+		}
+		b, _ := json.Marshal(m)
+		sum := sha256.Sum256(b)
+		return hex.EncodeToString(sum[:])
+	}
+	return ""
+}
+
+func (m *autoReplyModule) beginExecution(ctx context.Context, th module.Turn, cfg AutoReplyConfig) (context.Context, *execution, error) {
+	h, ok := m.turns.(module.ExecutionHost)
+	if !ok {
+		return ctx, nil, nil
+	}
+	var id [16]byte
+	if _, err := rand.Read(id[:]); err != nil {
+		return ctx, nil, err
+	}
+	revision := instructionRevision(th)
+	taskHash := sha256.Sum256([]byte(th.Ix))
+	dir := filepath.Join(m.env.StateDir, "executions", hex.EncodeToString(taskHash[:]), hex.EncodeToString(id[:]))
+	previous, previousErr := unfinishedExecution(filepath.Dir(dir), revision)
+	if previousErr != nil {
+		return ctx, nil, previousErr
+	}
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return ctx, nil, err
+	}
+	now := time.Now().UTC().Format(time.RFC3339Nano)
+	e := &execution{host: h, ix: th.Ix, revision: revision, dir: dir, snapshot: map[string]any{
+		"attempt_id": hex.EncodeToString(id[:]), "instruction_revision": revision,
+		"agent": cfg.Agent, "backend": cfg.Backend, "started_at": now,
+		"phase": "preparing_inputs", "heartbeat_at": now, "process_state": "not_started",
+		"side_effects": "none", "instruction_delivery": "accepted",
+		"business_verification": "not_automatically_verified",
+		"log_ref":               "executions/" + hex.EncodeToString(taskHash[:]) + "/" + hex.EncodeToString(id[:]),
+		"attachments_state":     "received", "workspace_root": cfg.WorkDir,
+	}}
+	e.snapshot["config_source"] = "auto_reply"
+	configBytes, _ := json.Marshal([]any{cfg.Backend, cfg.Agent, cfg.Command, cfg.ExtraArgs, cfg.WorkDir, cfg.WorkspaceMode, cfg.Runner, cfg.Model, cfg.TrustedMode(), cfg.AdmittedMode()})
+	configHash := sha256.Sum256(configBytes)
+	e.snapshot["config_revision"] = hex.EncodeToString(configHash[:])
+	if err := e.publish(ctx, false); err != nil {
+		return ctx, nil, err
+	}
+	if previous != "" {
+		e.set("previous_attempt", previous)
+		e.set("side_effects", "unknown")
+		_ = e.failure(ctx, fmt.Errorf("interrupted_attempt: prior execution has no confirmed end; inspect effects before retry"))
+		return ctx, nil, fmt.Errorf("interrupted_attempt: %s", previous)
+	}
+	return context.WithValue(ctx, executionKey{}, e), e, nil
+}
+
+// A daemon crash must not turn an unacknowledged execution into an automatic
+// second execution. Reconcile it explicitly; changing a message's text is not a
+// proof that its predecessor had no effects.
+func unfinishedExecution(dir, revision string) (string, error) {
+	dirs, err := os.ReadDir(dir)
+	if os.IsNotExist(err) {
+		return "", nil
+	}
+	if err != nil {
+		return "", err
+	}
+	for _, d := range dirs {
+		if !d.IsDir() {
+			continue
+		}
+		files, err := os.ReadDir(filepath.Join(dir, d.Name()))
+		if err != nil {
+			return "", err
+		}
+		if len(files) == 0 {
+			continue
+		}
+		b, err := os.ReadFile(filepath.Join(dir, d.Name(), files[len(files)-1].Name()))
+		if err != nil {
+			return "", err
+		}
+		var s map[string]any
+		if json.Unmarshal(b, &s) != nil {
+			return d.Name(), nil
+		}
+		switch s["phase"] {
+		case "completed", "failed", "superseded", "canceled":
+			continue
+		}
+		return d.Name(), nil
+	}
+	return "", nil
+}
+
+func executionOf(ctx context.Context) *execution {
+	e, _ := ctx.Value(executionKey{}).(*execution)
+	return e
+}
+
+func (e *execution) set(key string, value any) {
+	if e == nil {
+		return
+	}
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	e.snapshot[key] = value
+}
+
+func (e *execution) output() {
+	if e == nil {
+		return
+	}
+	e.set("last_output_at", time.Now().UTC().Format(time.RFC3339Nano))
+}
+
+func (e *execution) publish(ctx context.Context, failed bool) error {
+	if e == nil {
+		return nil
+	}
+	e.pub.Lock()
+	defer e.pub.Unlock()
+	e.mu.Lock()
+	e.seq++
+	e.snapshot["event_seq"] = e.seq
+	e.snapshot["heartbeat_at"] = time.Now().UTC().Format(time.RFC3339Nano)
+	phase, _ := e.snapshot["phase"].(string)
+	if phase != e.lastPhase {
+		e.lastPhase = phase
+		e.trace = append(e.trace, map[string]any{"phase": phase, "at": e.snapshot["heartbeat_at"]})
+		e.snapshot["timeline"] = e.trace
+		e.snapshot["last_progress_at"] = e.snapshot["heartbeat_at"]
+	}
+	b, err := json.Marshal(e.snapshot)
+	seq := e.seq
+	e.mu.Unlock()
+	if err != nil {
+		return err
+	}
+	err = e.persist(seq, b)
+	var copy map[string]any
+	_ = json.Unmarshal(b, &copy)
+	if err != nil {
+		e.set("journal_error", true)
+		copy["journal_error"] = true
+	}
+	// Remote delivery failure never reruns a model. A local journal failure
+	// is reported even when the event itself could not be stored.
+	remoteErr := e.host.ExecutionStatus(ctx, e.ix, copy, failed)
+	if err != nil {
+		return fmt.Errorf("execution_journal_failed: %w", err)
+	}
+	return remoteErr
+}
+
+func (e *execution) persist(seq int, b []byte) error {
+	// Each event is a new file, so a crash never overwrites an older attempt.
+	f, err := os.OpenFile(filepath.Join(e.dir, fmt.Sprintf("%08d.json", seq)), os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if err != nil {
+		return err
+	}
+	_, err = f.Write(b)
+	if err == nil {
+		err = f.Sync()
+	}
+	ce := f.Close()
+	if err == nil {
+		err = ce
+	}
+	if err != nil {
+		return err
+	}
+	return nil
+}
+
+func (e *execution) phase(ctx context.Context, phase string) {
+	if e == nil {
+		return
+	}
+	e.set("phase", phase)
+	_ = e.publish(ctx, false)
+}
+
+func (e *execution) process(started bool, code *int) {
+	if e == nil {
+		return
+	}
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	if started {
+		e.started = true
+		e.snapshot["process_state"] = "running"
+		e.snapshot["side_effects"] = "unknown"
+	} else {
+		e.snapshot["process_state"] = "exited"
+	}
+	if code != nil {
+		e.snapshot["exit_code"] = *code
+	}
+}
+
+// Stop the old process group before starting any new instruction. No backend
+// is advertised as supporting hot steering merely because its node received text.
+func (e *execution) watch(ctx context.Context, cancel context.CancelFunc) func() {
+	if e == nil {
+		return func() {}
+	}
+	stop, done := make(chan struct{}), make(chan struct{})
+	go func() {
+		defer close(done)
+		poll := time.NewTicker(500 * time.Millisecond)
+		defer poll.Stop()
+		heartbeat := time.NewTicker(10 * time.Second)
+		defer heartbeat.Stop()
+		for {
+			select {
+			case <-stop:
+				return
+			case <-ctx.Done():
+				return
+			case <-heartbeat.C:
+				_ = e.publish(ctx, false)
+			case <-poll.C:
+				if e.value("journal_error") == true {
+					cancel()
+					return
+				}
+				current, err := e.host.ExecutionTurn(e.ix)
+				if err != nil {
+					e.set("stop_requested", true)
+					cancel()
+					return
+				}
+				if instructionRevision(current) != e.revision {
+					e.mu.Lock()
+					e.superseded = true
+					e.mu.Unlock()
+					e.set("instruction_delivery", "next_turn_pending_stop")
+					e.set("next_instruction_revision", instructionRevision(current))
+					_ = e.publish(ctx, false)
+					cancel()
+					return
+				}
+			}
+		}
+	}()
+	return func() { close(stop); <-done }
+}
+
+// send binds the final result to the exact instruction revision atomically in
+// kernels that support the extension. Older hosts retain their existing seam.
+func (m *autoReplyModule) sendExecution(ctx context.Context, e *execution, ix, text string, atts []module.Attachment, final bool) error {
+	if h, ok := m.turns.(module.ExecutionReplyHost); ok && e != nil {
+		e.mu.Lock()
+		b, _ := json.Marshal(e.snapshot)
+		e.mu.Unlock()
+		var snapshot map[string]any
+		_ = json.Unmarshal(b, &snapshot)
+		snapshot["phase"] = "completed"
+		snapshot["finished_at"] = time.Now().UTC().Format(time.RFC3339Nano)
+		err := h.SendExecutionTurn(ctx, ix, e.revision, text, atts, final, snapshot)
+		if errors.Is(err, module.ErrInstructionSuperseded) {
+			e.set("instruction_delivery", "old_execution_stopped")
+			e.phase(ctx, "superseded")
+		}
+		return err
+	}
+	return m.turns.SendTurn(ctx, ix, text, atts, final)
+}
+
+func (e *execution) current() bool {
+	if e == nil {
+		return true
+	}
+	th, err := e.host.ExecutionTurn(e.ix)
+	return err == nil && instructionRevision(th) == e.revision
+}
+
+func (e *execution) failure(ctx context.Context, err error) error {
+	if e == nil {
+		return err
+	}
+	category, summary := "backend_error", "Backend failed; inspect the attempt's local diagnostics."
+	code := 0
+	var exit *exec.ExitError
+	switch {
+	case e.value("journal_error") == true:
+		category, summary = "execution_journal_failed", "Execution stopped because its durable event journal could not be written."
+	case strings.Contains(err.Error(), "stop_unconfirmed"):
+		category, summary = "stop_unconfirmed", "The old executor has not confirmed stopping; no new execution was started."
+	case strings.Contains(err.Error(), "interrupted_attempt"):
+		category, summary = "interrupted_attempt", "An earlier attempt has no confirmed end; inspect its effects before starting another attempt."
+	case errors.Is(err, context.DeadlineExceeded):
+		category, summary = "timeout", "Backend exceeded its execution deadline."
+	case errors.Is(err, context.Canceled):
+		category, summary = "interrupted", "Execution was interrupted; effects require verification."
+	case errors.As(err, &exit):
+		code = exit.ExitCode()
+		category, summary = "process_exit", fmt.Sprintf("Backend exited with code %d.", code)
+	case strings.Contains(err.Error(), "attachment_"):
+		category, summary = "attachment_failed", "Input attachment could not be verified, materialized, or read by this backend."
+		for _, code := range []string{"attachment_integrity_failed", "attachment_size_mismatch", "attachment_size_limit", "attachment_limit", "attachment_unavailable", "attachment_write_failed", "attachment_backend_unsupported"} {
+			if strings.Contains(err.Error(), code) {
+				e.set("error_code", code)
+				break
+			}
+		}
+		e.set("attachments_state", "failed")
+	case strings.Contains(err.Error(), "outbox:"):
+		category, summary = "result_collection_failed", "Backend ran but its result files could not be collected."
+	case strings.Contains(err.Error(), "work_dir") || strings.Contains(err.Error(), "workspace"):
+		category, summary = "configuration_error", "Workspace configuration or project binding failed."
+	case errors.Is(err, errAgentOutputTooLarge):
+		category, summary = "output_limit", "Backend output exceeded the configured limit."
+	}
+	if e.value("error_category") == "process_start_failed" {
+		category, summary = "process_start_failed", "The backend process could not be started."
+	}
+	e.set("failure_phase", e.value("phase"))
+	e.set("phase", "failed")
+	e.set("error_category", category)
+	e.set("error_summary", summary) // allowlisted summaries, never raw stderr/secrets
+	e.set("finished_at", time.Now().UTC().Format(time.RFC3339Nano))
+	if code != 0 {
+		e.set("exit_code", code)
+	}
+	return e.publish(ctx, true)
+}
+
+func (e *execution) value(k string) any {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	return e.snapshot[k]
+}
+
+type activityWriter struct{ e *execution }
+
+func (w activityWriter) Write(p []byte) (int, error) { w.e.output(); return len(p), nil }
