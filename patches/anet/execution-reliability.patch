@@ -0,0 +1,55 @@
+package release
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestMaintenanceStagesSignedRuntimeWithoutReplacingLauncher(t *testing.T) {
+	f := newFixture(t)
+	var m map[string]any
+	if err := json.Unmarshal(f.manifest, &m); err != nil {
+		t.Fatal(err)
+	}
+	m["maintenance"] = MaintenancePolicy{Protocol: MaintenanceProtocol, DataEpoch: DataEpoch}
+	f.manifest, _ = json.Marshal(m)
+	f.sig = signSSHSIG(f.priv, f.manifest, Namespace)
+	f.files["/dl/release.json"], f.files["/dl/release.json.sig"] = f.manifest, f.sig
+	srv := f.server()
+	u, launcher := f.updater(srv, "0.1.0")
+	found, err := u.Check(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !found.Manifest.CanAutoUpdate() {
+		t.Fatal("signed policy missing")
+	}
+	u.Exe = filepath.Join(t.TempDir(), "anet")
+	if err = u.Apply(context.Background(), found); err != nil {
+		t.Fatal(err)
+	}
+	if err = SaveInstalled(u.Exe, found.Raw, found.Sig); err != nil {
+		t.Fatal(err)
+	}
+	if check := CheckInstalled(u.Exe, u.Trust, f.now); check.Status != InstalledVerified {
+		t.Fatal(check)
+	}
+	untouched(t, launcher)
+	if err = os.WriteFile(u.Exe, []byte("tampered"), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if check := CheckInstalled(u.Exe, u.Trust, f.now); check.Status == InstalledVerified {
+		t.Fatal("tampering accepted")
+	}
+}
+
+func TestMaintenanceRequiresCompatibleSignedPolicy(t *testing.T) {
+	for _, policy := range []*MaintenancePolicy{nil, {Protocol: 99, DataEpoch: DataEpoch}, {Protocol: MaintenanceProtocol, DataEpoch: 99}} {
+		if (&Manifest{Maintenance: policy}).CanAutoUpdate() {
+			t.Fatalf("unsafe policy: %+v", policy)
+		}
+	}
+}
