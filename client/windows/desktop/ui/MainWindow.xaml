<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ANet · 设备设置" Width="1080" Height="780" MinWidth="850" MinHeight="660" WindowStartupLocation="CenterScreen" Background="#06070B" Foreground="#E9EDF4" FontFamily="Segoe UI, Microsoft YaHei" FontSize="14" UseLayoutRounding="True">
<Window.Resources>
 <SolidColorBrush x:Key="Panel" Color="#11151E"/>
 <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#11151E"/><Setter Property="BorderBrush" Value="#29303D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="24"/></Style>
 <Style TargetType="Button"><Setter Property="Foreground" Value="#E9EDF4"/><Setter Property="Background" Value="#242B38"/><Setter Property="BorderBrush" Value="#394253"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="42"/><Setter Property="FontSize" Value="13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#FF9154"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#38E8C6"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#FF5B36"/><Setter Property="BorderBrush" Value="#FF5B36"/><Setter Property="Foreground" Value="#06070B"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="16,13"/><Setter Property="Background" Value="Transparent"/></Style>
 <Style TargetType="TextBox"><Setter Property="Foreground" Value="#E9EDF4"/><Setter Property="Background" Value="#0B0E15"/><Setter Property="BorderBrush" Value="#414B5D"/><Setter Property="CaretBrush" Value="#FF9154"/><Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="42"/><Setter Property="SelectionBrush" Value="#8D442C"/><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#FF9154"/></Trigger></Style.Triggers></Style>
 <Style TargetType="PasswordBox"><Setter Property="Foreground" Value="#E9EDF4"/><Setter Property="Background" Value="#0B0E15"/><Setter Property="BorderBrush" Value="#414B5D"/><Setter Property="CaretBrush" Value="#FF9154"/><Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="42"/></Style>
 <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#A7B0C0"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
 <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
 <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Background" Value="#0B0E15"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#414B5D" CornerRadius="5" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#A7B0C0"/><Setter Property="Margin" Value="0,14,0,0"/></Style>
</Window.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Background="#0B0E15" BorderBrush="#252C38" BorderThickness="0,0,1,0"><Grid Margin="20,28,20,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="14,0,0,34"><StackPanel Orientation="Horizontal"><TextBlock Text="A" Foreground="#FF5B36" FontFamily="Bahnschrift" FontSize="33" FontWeight="Bold"/><TextBlock Text="NET" FontFamily="Bahnschrift" FontSize="33" FontWeight="Bold"/></StackPanel><TextBlock Text="设备设置" FontSize="12" Foreground="#A7B0C0" Margin="0,6,0,0"/></StackPanel>
  <StackPanel Grid.Row="1"><Button x:Name="NavAccount" Style="{StaticResource Nav}" Content="账户与连接"/><Button x:Name="NavAgents" Style="{StaticResource Nav}" Content="智能体"/><Button x:Name="NavWorkspace" Style="{StaticResource Nav}" Content="工作目录"/><Button x:Name="NavServices" Style="{StaticResource Nav}" Content="服务与更新"/></StackPanel>
  <StackPanel Grid.Row="3" Margin="14,0,10,0"><TextBlock x:Name="SidebarStatus" Text="等待连接" FontSize="12" Foreground="#A7B0C0"/><TextBlock Text="配置完成后，在智能体软件中开始工作。" FontSize="11" Foreground="#A7B0C0" Margin="0,10,0,0" LineHeight="18"/></StackPanel>
 </Grid></Border>
 <Grid Grid.Column="1" Margin="36,32,36,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,26"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock x:Name="PageTitle" Text="连接你的设备" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="登录 ANet，完成这台电脑的网络连接。" Foreground="#A7B0C0" FontSize="13" Margin="0,10,0,0"/></StackPanel><Button x:Name="RefreshAll" Grid.Column="1" Content="刷新状态" VerticalAlignment="Top"/></Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><Grid x:Name="PageContent">
   <StackPanel x:Name="AccountPage">
    <Border Style="{StaticResource Card}" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#38E8C6" CornerRadius="2"/><StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock x:Name="ConnectionState" Text="设备尚未连接" FontSize="18" FontWeight="SemiBold" Foreground="#FFB547"/><TextBlock x:Name="ConnectionDetail" Text="登录后，ANet 会自动为这台电脑配置网络权限。" Foreground="#A7B0C0" FontSize="12" Margin="0,8,0,0"/></StackPanel></Grid></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="登录 ANet" Style="{StaticResource Section}"/><TextBlock x:Name="AccountSummary" Text="使用门户账户登录即可连接设备。" Foreground="#A7B0C0" FontSize="13" Margin="0,0,0,22"/>
     <TextBlock Text="门户地址" Style="{StaticResource Label}"/><TextBox x:Name="PortalUrl" Text="https://124.222.173.36:8888" AutomationProperties.Name="门户地址" Margin="0,0,0,18"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="账户" Style="{StaticResource Label}"/><TextBox x:Name="Username" AutomationProperties.Name="账户"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="密码" Style="{StaticResource Label}"/><PasswordBox x:Name="Password" AutomationProperties.Name="密码"/></StackPanel></Grid>
     <StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button x:Name="Login" Content="登录并连接" Style="{StaticResource Primary}" MinWidth="136"/><Button x:Name="Logout" Content="退出账户" Margin="12,0,0,0" Visibility="Collapsed"/></StackPanel>
     <TextBlock Text="密码仅用于本次登录。智能体软件的账户，请在对应软件中登录。" Foreground="#A7B0C0" FontSize="11" Margin="0,18,0,0" LineHeight="19"/>
    </StackPanel></Border>
    <Button x:Name="NextAgents" Content="下一步：连接智能体  →" HorizontalAlignment="Left" Margin="0,18,0,0"/>
   </StackPanel>
   <StackPanel x:Name="AgentsPage" Visibility="Collapsed"><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="一次配置，在熟悉的软件里使用" Style="{StaticResource Section}"/><TextBlock Text="连接 ANet 会添加该软件的 MCP 配置。完成后重新打开软件，并按软件提示确认连接。" Foreground="#A7B0C0" FontSize="13" LineHeight="22"/><TextBlock Text="各软件的登录与订阅仍由对应软件管理。" Foreground="#A7B0C0" FontSize="12" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="让这台电脑接收协作" Style="{StaticResource Section}"/><TextBlock Text="在下面选择一个执行器，开启后即可从门户或其他已授权的智能体调用这台电脑。" Foreground="#A7B0C0" FontSize="12" LineHeight="21"/><TextBlock x:Name="ReceiverState" Text="等待检查接收协作设置。" Foreground="#A7B0C0" Margin="0,12,0,0"/><Button x:Name="ReceiverRefresh" Content="刷新接收状态" HorizontalAlignment="Left" Margin="0,12,0,0"/><StackPanel x:Name="ReceiverPanel" Visibility="Collapsed" Margin="0,18,0,0"><TextBlock x:Name="ReceiverSelection" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="输入当前门户账户的密码，确认开启。将运行一次简短模型自检，完成后显示实际连接状态。" Foreground="#A7B0C0" FontSize="12" Margin="0,10,0,16" LineHeight="21"/><TextBlock Text="门户密码" Style="{StaticResource Label}"/><PasswordBox x:Name="ReceiverPassword" AutomationProperties.Name="开启接收协作的门户密码"/><Button x:Name="ReceiverEnable" Content="开启接收并测试" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,14,0,0"/></StackPanel></StackPanel></Border><StackPanel x:Name="AgentList"><TextBlock Text="正在读取智能体配置…" Foreground="#A7B0C0"/></StackPanel></StackPanel>
   <StackPanel x:Name="WorkspacePage" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="默认工作文件夹" Style="{StaticResource Section}"/><TextBlock Text="选择用于远程协作的工作位置。已有工作和文件会保留在原来的目录。" Foreground="#A7B0C0" FontSize="13" LineHeight="22" Margin="0,0,0,24"/><TextBlock Text="文件夹路径" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="WorkspacePath" AutomationProperties.Name="工作文件夹路径"/><Button x:Name="BrowseWorkspace" Grid.Column="1" Content="选择文件夹" Margin="12,0,0,0"/></Grid><Button x:Name="SaveWorkspace" Content="保存工作目录" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,22,0,0"/><TextBlock Text="请选用你可以读写的文件夹。智能体在执行工作时仍会遵循它自己的权限设置。" Foreground="#A7B0C0" FontSize="12" LineHeight="20" Margin="0,18,0,0"/></StackPanel></Border></StackPanel>
   <StackPanel x:Name="ServicesPage" Visibility="Collapsed"><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="连接服务" Style="{StaticResource Section}"/><StackPanel x:Name="ServiceList"><TextBlock Text="等待检查服务状态。" Foreground="#A7B0C0"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button x:Name="ServiceStart" Content="启动服务"/><Button x:Name="ServiceStop" Content="停止服务" Margin="12,0,0,0"/><Button x:Name="Doctor" Content="检查连接" Margin="12,0,0,0"/></StackPanel><TextBlock x:Name="Diagnostics" Text="连接异常时，运行检查可查看下一步处理建议。" Foreground="#A7B0C0" FontSize="12" LineHeight="20" Margin="0,18,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="软件更新" Style="{StaticResource Section}"/><TextBlock x:Name="UpdateState" Text="等待检查更新。" Foreground="#A7B0C0" FontSize="13"/><CheckBox x:Name="UpdateAuto" Content="自动下载更新，退出时安装"/><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button x:Name="UpdateCheck" Content="检查更新"/><Button x:Name="UpdateApply" Content="退出并安装" Margin="12,0,0,0" IsEnabled="False"/></StackPanel></StackPanel></Border></StackPanel>
  </Grid></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,18,0,0"><ProgressBar x:Name="BusyIndicator" Height="2" IsIndeterminate="True" Foreground="#FF5B36" Background="#252C38" Visibility="Collapsed" Margin="0,0,0,10"/><TextBlock x:Name="NoticeText" AutomationProperties.LiveSetting="Polite" Text="就绪" FontSize="12" Foreground="#A7B0C0"/></StackPanel>
 </Grid>
</Grid></Window>